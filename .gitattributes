# Normalize line endings: LF in the repo, native on checkout unless set below.
* text=auto

# Visual Studio and MSBuild files keep CRLF on every platform.
*.sln       text eol=crlf
*.slnx      text eol=crlf
*.csproj    text eol=crlf
*.props     text eol=crlf
*.targets   text eol=crlf
*.manifest  text eol=crlf
*.xaml      text eol=crlf
*.cs        text eol=crlf diff=csharp
*.ps1       text eol=crlf

# Shell scripts must stay LF.
*.sh        text eol=lf

*.md        text diff=markdown

# Binary files: no line ending changes, no text diffs.
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.bmp       binary
*.ico       binary
*.webp      binary
*.ttf       binary
*.otf       binary
*.woff      binary
*.woff2     binary
*.dll       binary
*.exe       binary
*.pdb       binary
*.zip       binary
*.7z        binary
*.nupkg     binary
*.snupkg    binary
*.msix      binary
*.appx      binary
*.pfx       binary
*.snk       binary
