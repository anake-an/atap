<Project>

  <!-- Central package management: every package version is set here, never in a .csproj file. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- Applied to every project as a build-only dependency. -->
    <GlobalPackageReference Include="MinVer" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <!-- Keep in step with the vpk tool in .config/dotnet-tools.json. -->
    <PackageVersion Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <!-- Every package later features need lands here at once, so the project files stay frozen.
       None of them is loaded until the feature that uses it is turned on. -->
  <ItemGroup Label="Features">
    <!-- Volume, audio devices and per-app sessions. -->
    <PackageVersion Include="NAudio.Wasapi" Version="3.3.0" />
    <!-- Home Assistant over MQTT. -->
    <PackageVersion Include="MQTTnet" Version="5.2.0.1603" />
    <!-- Brightness change events through WMI. -->
    <PackageVersion Include="System.Management" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageVersion Include="xunit" Version="2.9.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

</Project>
