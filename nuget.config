<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!-- Restore from nuget.org only, whatever sources the machine has set up. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <!-- Every package, tools included, must come from nuget.org. -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

</configuration>
