<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:position="clr-namespace:Atap.Settings.Cards.Position"
                    xmlns:loc="clr-namespace:Atap.Ui.Localization">

  <!-- Merged into the settings window only while it is open. Loaded on its own, so the settings styles
       are DynamicResource: they come from the window. -->
  <BooleanToVisibilityConverter x:Key="Card.BoolToVisibility" />

  <DataTemplate DataType="{x:Type position:PositionCardViewModel}">
    <DataTemplate.Resources>
      <!-- One picture per spot. Arrow keys move between them, and the notch moves right away. -->
      <Style x:Key="Position.PictureItem" TargetType="ListBoxItem">
        <Setter Property="FocusVisualStyle" Value="{DynamicResource Settings.FocusVisual}" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ListBoxItem">
              <Border x:Name="Chrome" Padding="6" CornerRadius="8" BorderThickness="2" BorderBrush="Transparent" Background="Transparent">
                <ContentPresenter />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource WindowBrush}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                  <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource ToggleOnBrush}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </DataTemplate.Resources>

    <StackPanel>
      <Border Style="{DynamicResource Settings.Card}">
        <StackPanel>
          <TextBlock Text="{loc:T position.hint}" Style="{DynamicResource Settings.Hint}" Margin="0,0,0,12" />
          <ListBox ItemsSource="{Binding Anchors}" SelectedItem="{Binding SelectedAnchor}"
                   ItemContainerStyle="{StaticResource Position.PictureItem}"
                   Background="Transparent" BorderThickness="0"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   ScrollViewer.VerticalScrollBarVisibility="Disabled"
                   AutomationProperties.Name="{Binding AnchorsName}">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Width="96">
                  <!-- A small screen with the notch where it would sit. -->
                  <Border Width="96" Height="60" CornerRadius="6" BorderThickness="1"
                          BorderBrush="{DynamicResource InkMutedBrush}" Background="{DynamicResource SettingsCardBrush}">
                    <Border Width="{Binding NotchWidth}" Height="{Binding NotchHeight}" CornerRadius="2"
                            Background="{DynamicResource NotchSurfaceBrush}"
                            HorizontalAlignment="{Binding Horizontal}" VerticalAlignment="{Binding Vertical}"
                            Margin="{Binding NotchMargin}" />
                  </Border>
                  <TextBlock Text="{Binding Label}" Style="{DynamicResource Settings.Label}" FontSize="13"
                             HorizontalAlignment="Center" TextAlignment="Center" Margin="0,6,0,0" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Text="{Binding Message}" Style="{DynamicResource Settings.Error}"
                     Visibility="{Binding HasMessage, Converter={StaticResource Card.BoolToVisibility}}" />
        </StackPanel>
      </Border>

      <Border Style="{DynamicResource Settings.Card}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
            <TextBlock Text="{Binding ScreenLabel}" Style="{DynamicResource Settings.Label}" />
            <TextBlock Text="{Binding ScreenHint}" Style="{DynamicResource Settings.Hint}" />
          </StackPanel>
          <ComboBox Grid.Column="1" Style="{DynamicResource Settings.ComboBox}" MinWidth="220"
                    ItemsSource="{Binding Screens}" SelectedItem="{Binding SelectedScreen}" DisplayMemberPath="Label"
                    AutomationProperties.Name="{Binding ScreenLabel}" AutomationProperties.HelpText="{Binding ScreenHint}" />
        </Grid>
      </Border>

      <Border Style="{DynamicResource Settings.Card}"
              Visibility="{Binding CanEditLayout, Converter={StaticResource Card.BoolToVisibility}}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
            <TextBlock Text="{loc:T position.editLayout}" Style="{DynamicResource Settings.Label}" />
            <TextBlock Text="{loc:T position.editLayoutHint}" Style="{DynamicResource Settings.Hint}" />
          </StackPanel>
          <Button Grid.Column="1" Style="{DynamicResource Settings.Button}" Content="{loc:T position.editLayout}"
                  Command="{Binding EditLayoutCommand}" />
        </Grid>
      </Border>
    </StackPanel>
  </DataTemplate>

</ResourceDictionary>
