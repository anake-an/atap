<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:layout="clr-namespace:Atap.Settings.Cards.Layout"
                    xmlns:loc="clr-namespace:Atap.Ui.Localization">

  <!-- Merged into the settings window only while it is open. Loaded on its own, so the settings styles
       are DynamicResource: they come from the window. -->
  <BooleanToVisibilityConverter x:Key="Card.BoolToVisibility" />

  <DataTemplate DataType="{x:Type layout:LayoutCardViewModel}">
    <StackPanel>
      <Border Style="{DynamicResource Settings.Card}" Visibility="{Binding CanEdit, Converter={StaticResource Card.BoolToVisibility}}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
            <TextBlock Text="{loc:T layoutcard.edit}" Style="{DynamicResource Settings.Label}" />
            <TextBlock Text="{loc:T layoutcard.editHint}" Style="{DynamicResource Settings.Hint}" TextWrapping="Wrap" />
          </StackPanel>
          <Button Grid.Column="1" Style="{DynamicResource Settings.AccentButton}" Content="{loc:T layoutcard.edit}"
                  Command="{Binding EditCommand}" VerticalAlignment="Center" />
        </Grid>
      </Border>
      <Border Style="{DynamicResource Settings.Card}" Visibility="{Binding CanRestore, Converter={StaticResource Card.BoolToVisibility}}">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
              <TextBlock Text="{loc:T layoutcard.restore}" Style="{DynamicResource Settings.Label}" />
              <TextBlock Text="{loc:T layoutcard.restoreHint}" Style="{DynamicResource Settings.Hint}" TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="1" Style="{DynamicResource Settings.Button}" Content="{loc:T layoutcard.restoreButton}"
                    Command="{Binding RestoreCommand}" VerticalAlignment="Center" />
          </Grid>
          <TextBlock Text="{Binding Message}" Style="{DynamicResource Settings.Hint}" Margin="0,8,0,0" TextWrapping="Wrap"
                     AutomationProperties.LiveSetting="Polite"
                     Visibility="{Binding HasMessage, Converter={StaticResource Card.BoolToVisibility}}" />
        </StackPanel>
      </Border>
    </StackPanel>
  </DataTemplate>

</ResourceDictionary>
