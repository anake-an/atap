<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:profiles="clr-namespace:Atap.Settings.Cards.Profiles"
                    xmlns:loc="clr-namespace:Atap.Ui.Localization">

  <!-- Merged into the settings window only while it is open. Loaded on its own, so the settings styles
       are DynamicResource: they come from the window. -->
  <BooleanToVisibilityConverter x:Key="Card.BoolToVisibility" />

  <DataTemplate DataType="{x:Type profiles:ProfilesCardViewModel}">
    <StackPanel>
      <Border Style="{DynamicResource Settings.Card}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
            <TextBlock Text="{loc:T profilescard.usual}" Style="{DynamicResource Settings.Label}" />
            <TextBlock Text="{loc:T profilescard.usualHint}" Style="{DynamicResource Settings.Hint}" TextWrapping="Wrap" />
          </StackPanel>
          <ComboBox Grid.Column="1" Style="{DynamicResource Settings.ComboBox}" MinWidth="200" VerticalAlignment="Center"
                    ItemsSource="{Binding Choices}" SelectedItem="{Binding Usual}" DisplayMemberPath="Name"
                    AutomationProperties.Name="{loc:T profilescard.usual}" />
        </Grid>
      </Border>

      <Border Style="{DynamicResource Settings.Card}">
        <StackPanel>
          <TextBlock Text="{loc:T profilescard.list}" Style="{DynamicResource Settings.Label}" />
          <TextBlock Text="{loc:T profilescard.listHint}" Style="{DynamicResource Settings.Hint}" TextWrapping="Wrap" Margin="0,0,0,10" />
          <ItemsControl ItemsSource="{Binding Profiles}" Focusable="False"
                        Visibility="{Binding HasProfiles, Converter={StaticResource Card.BoolToVisibility}}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <DockPanel Margin="0,0,0,6" AutomationProperties.Name="{Binding Name}">
                  <Button DockPanel.Dock="Right" Style="{DynamicResource Settings.Button}" Content="{loc:T profilescard.remove}"
                          Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                          CommandParameter="{Binding Id}" AutomationProperties.Name="{Binding Name}" Margin="6,0,0,0" />
                  <Button DockPanel.Dock="Right" Style="{DynamicResource Settings.Button}" Content="{loc:T profilescard.edit}"
                          Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                          CommandParameter="{Binding Id}" AutomationProperties.Name="{Binding Name}" />
                  <TextBlock Text="{Binding Name}" Style="{DynamicResource Settings.Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </DockPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <DockPanel Margin="0,6,0,0">
            <Button DockPanel.Dock="Right" Style="{DynamicResource Settings.AccentButton}" Content="{loc:T profilescard.add}"
                    Command="{Binding AddCommand}" Margin="6,0,0,0" VerticalAlignment="Bottom" />
            <StackPanel>
              <TextBlock Text="{loc:T profilescard.name}" Style="{DynamicResource Settings.Hint}" />
              <TextBox Style="{DynamicResource Settings.TextBox}" Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}"
                       AutomationProperties.Name="{loc:T profilescard.name}" />
            </StackPanel>
          </DockPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </DataTemplate>

</ResourceDictionary>
