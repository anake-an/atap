<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:network="clr-namespace:Atap.Settings.Cards.Privacy.NetworkFeatures">

  <!-- Merged into the settings window only while it is open. Loaded on its own, so the settings styles
       are DynamicResource: they come from the window. -->
  <BooleanToVisibilityConverter x:Key="Card.BoolToVisibility" />

  <DataTemplate DataType="{x:Type network:NetworkUse}">
    <Border Style="{DynamicResource Settings.Card}" AutomationProperties.Name="{Binding}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,16,0">
          <TextBlock Text="{Binding Name}" Style="{DynamicResource Settings.Label}" />
          <TextBlock Text="{Binding Detail}" Style="{DynamicResource Settings.Hint}" />
          <TextBlock Text="{Binding Note}" Style="{DynamicResource Settings.Hint}" Margin="0,6,0,0"
                     Visibility="{Binding HasNote, Converter={StaticResource Card.BoolToVisibility}}" />
          <TextBlock Text="{Binding TurnOnHint}" Style="{DynamicResource Settings.Hint}" Margin="0,6,0,0"
                     Visibility="{Binding HasTurnOnHint, Converter={StaticResource Card.BoolToVisibility}}" />
        </StackPanel>
        <!-- On or Off as a small chip: filled with the accent while on, outlined while off. -->
        <Border x:Name="Chip" Grid.Column="1" VerticalAlignment="Top" Margin="0,1,0,0" MinWidth="48" Padding="10,3"
                CornerRadius="6" BorderThickness="1"
                Background="{DynamicResource WindowBrush}" BorderBrush="{DynamicResource SettingsCardBorderBrush}">
          <TextBlock x:Name="ChipText" Text="{Binding StateText}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"
                     Foreground="{DynamicResource InkSecondaryBrush}" />
        </Border>
      </Grid>
    </Border>
    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding IsOn}" Value="True">
        <Setter TargetName="Chip" Property="Background" Value="{DynamicResource ToggleOnBrush}" />
        <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource ToggleOnBrush}" />
        <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource SettingsCardBrush}" />
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>

  <DataTemplate DataType="{x:Type network:NetworkFeaturesViewModel}">
    <StackPanel>
      <TextBlock Text="{Binding Hint}" Style="{DynamicResource Settings.Hint}" Margin="0,0,0,8" />
      <Border Style="{DynamicResource Settings.Card}" Visibility="{Binding IsEmpty, Converter={StaticResource Card.BoolToVisibility}}">
        <TextBlock Text="{Binding EmptyText}" Style="{DynamicResource Settings.Label}" />
      </Border>
      <ItemsControl ItemsSource="{Binding Items}" Focusable="False" IsTabStop="False" />
    </StackPanel>
  </DataTemplate>

</ResourceDictionary>
