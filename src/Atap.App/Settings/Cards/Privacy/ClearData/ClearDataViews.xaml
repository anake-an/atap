<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:clear="clr-namespace:Atap.Settings.Cards.Privacy.ClearData"
                    xmlns:loc="clr-namespace:Atap.Ui.Localization">

  <!-- Merged into the settings window only while it is open. Loaded on its own, so the settings styles
       are DynamicResource: they come from the window. -->
  <BooleanToVisibilityConverter x:Key="Card.BoolToVisibility" />

  <DataTemplate DataType="{x:Type clear:ClearDataViewModel}">
    <Border Style="{DynamicResource Settings.Card}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
          <TextBlock Text="{loc:T cleardata.hint}" Style="{DynamicResource Settings.Label}" />
          <TextBlock Text="{Binding SizeText}" Style="{DynamicResource Settings.Hint}" />
          <TextBlock Text="{Binding KeysText}" Style="{DynamicResource Settings.Hint}" TextWrapping="Wrap"
                     Visibility="{Binding HasKeys, Converter={StaticResource Card.BoolToVisibility}}" />
          <TextBlock Text="{Binding ResultText}" Style="{DynamicResource Settings.Hint}"
                     Visibility="{Binding HasResult, Converter={StaticResource Card.BoolToVisibility}}" />
          <TextBlock Text="{Binding KeysRemovedText}" Style="{DynamicResource Settings.Hint}" TextWrapping="Wrap"
                     Visibility="{Binding HasKeysRemoved, Converter={StaticResource Card.BoolToVisibility}}" />
        </StackPanel>
        <Button Grid.Column="1" Style="{DynamicResource Settings.Button}" Content="{loc:T cleardata.clear}"
                Command="{Binding ClearCommand}" VerticalAlignment="Center" />
      </Grid>
    </Border>
  </DataTemplate>

</ResourceDictionary>
