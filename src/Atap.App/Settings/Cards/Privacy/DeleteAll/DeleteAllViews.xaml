<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:deleteall="clr-namespace:Atap.Settings.Cards.Privacy.DeleteAll"
                    xmlns:loc="clr-namespace:Atap.Ui.Localization">

  <!-- Merged into the settings window only while it is open. Loaded on its own, so the settings styles
       are DynamicResource: they come from the window. -->
  <BooleanToVisibilityConverter x:Key="DeleteAll.BoolToVisibility" />

  <!-- The one red button: filled, so it never looks like the plain buttons around it. 6 px corners, like
       every Settings button. In high contrast it takes the Highlight colours, as the accent button does. -->
  <Style x:Key="DeleteAll.DangerButton" TargetType="Button">
    <Setter Property="FocusVisualStyle" Value="{DynamicResource Settings.FocusVisual}" />
    <Setter Property="Background" Value="{DynamicResource SystemAccentLightBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentLightBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource SettingsCardBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="12,5" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="MinWidth" Value="80" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="Opacity" Value="0.9" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Chrome" Property="Opacity" Value="0.8" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <DataTemplate DataType="{x:Type deleteall:DeleteAllViewModel}">
    <Border Style="{DynamicResource Settings.Card}" AutomationProperties.Name="{loc:T deleteall.title}">
      <StackPanel>
        <!-- First step: what it is, and one button that only asks. -->
        <Grid Visibility="{Binding IsAsking, Converter={StaticResource DeleteAll.BoolToVisibility}}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="{loc:T deleteall.hint}" Style="{DynamicResource Settings.Label}" TextWrapping="Wrap"
                     VerticalAlignment="Center" Margin="0,0,16,0" />
          <Button Grid.Column="1" Style="{DynamicResource Settings.Button}" Content="{loc:T deleteall.button}"
                  Command="{Binding AskCommand}" VerticalAlignment="Center" />
        </Grid>

        <!-- Second step: says plainly what goes, then delete or cancel. -->
        <StackPanel Visibility="{Binding IsConfirming, Converter={StaticResource DeleteAll.BoolToVisibility}}">
          <TextBlock Text="{loc:T deleteall.confirmTitle}" Style="{DynamicResource Settings.Label}" FontWeight="SemiBold"
                     TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />
          <TextBlock Text="{loc:T deleteall.whatGoes}" Style="{DynamicResource Settings.Hint}" TextWrapping="Wrap" Margin="0,6,0,0" />
          <TextBlock Text="{loc:T deleteall.closes}" Style="{DynamicResource Settings.Hint}" TextWrapping="Wrap" Margin="0,6,0,0" />
          <TextBlock Text="{loc:T deleteall.sync}" Style="{DynamicResource Settings.Hint}" TextWrapping="Wrap" Margin="0,6,0,0" />
          <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <Button Style="{StaticResource DeleteAll.DangerButton}" Content="{loc:T deleteall.confirm}"
                    Command="{Binding DeleteCommand}" Margin="0,0,8,0" />
            <Button Style="{DynamicResource Settings.Button}" Content="{loc:T deleteall.cancel}" Command="{Binding CancelCommand}" />
          </StackPanel>
          <TextBlock Text="{loc:T deleteall.deleting}" Style="{DynamicResource Settings.Hint}" Margin="0,8,0,0"
                     AutomationProperties.LiveSetting="Polite"
                     Visibility="{Binding IsDeleting, Converter={StaticResource DeleteAll.BoolToVisibility}}" />
        </StackPanel>
      </StackPanel>
    </Border>
  </DataTemplate>

</ResourceDictionary>
