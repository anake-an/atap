<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:widgets="clr-namespace:Atap.Settings.Cards.Widgets"
                    xmlns:loc="clr-namespace:Atap.Ui.Localization">

  <!-- Merged into the settings window only while it is open. Loaded on its own, so the settings styles
       are DynamicResource: they come from the window. -->
  <BooleanToVisibilityConverter x:Key="Card.BoolToVisibility" />

  <DataTemplate DataType="{x:Type widgets:WidgetRowViewModel}">
    <Border Style="{DynamicResource Settings.Card}" AutomationProperties.Name="{Binding Name}">
      <StackPanel>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
            <TextBlock Text="{Binding Name}" Style="{DynamicResource Settings.Label}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding StatusText}" Style="{DynamicResource Settings.Hint}" />
            <TextBlock Text="{Binding StatusDetail}" Style="{DynamicResource Settings.Hint}"
                       Visibility="{Binding HasStatusDetail, Converter={StaticResource Card.BoolToVisibility}}" />
          </StackPanel>
          <Button Grid.Column="1" Style="{DynamicResource Settings.AccentButton}" Content="{loc:T widgetlist.restart}"
                  Command="{Binding RestartCommand}" AutomationProperties.Name="{Binding RestartName}"
                  Visibility="{Binding CanRestart, Converter={StaticResource Card.BoolToVisibility}}" />
        </Grid>
        <!-- The form is built only when this is opened. -->
        <Expander Style="{DynamicResource Settings.Expander}" IsExpanded="{Binding IsExpanded}"
                  Header="{loc:T widgetlist.settingsShort}" AutomationProperties.Name="{Binding SettingsHeader}"
                  Visibility="{Binding HasSettings, Converter={StaticResource Card.BoolToVisibility}}">
          <ContentControl Content="{Binding Form}" Focusable="False" IsTabStop="False" />
        </Expander>
      </StackPanel>
    </Border>
  </DataTemplate>

  <DataTemplate DataType="{x:Type widgets:WidgetsCardViewModel}">
    <StackPanel>
      <Border Style="{DynamicResource Settings.Card}" Visibility="{Binding IsEmpty, Converter={StaticResource Card.BoolToVisibility}}">
        <TextBlock Text="{Binding EmptyText}" Style="{DynamicResource Settings.Label}" />
      </Border>
      <ItemsControl ItemsSource="{Binding Rows}" Focusable="False" IsTabStop="False" />
    </StackPanel>
  </DataTemplate>

</ResourceDictionary>
