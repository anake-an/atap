<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:version="clr-namespace:Atap.Settings.Cards.About.Version"
                    xmlns:loc="clr-namespace:Atap.Ui.Localization">

  <!-- Merged into the settings window only while it is open. Loaded on its own, so the settings styles
       are DynamicResource: they come from the window. -->
  <BooleanToVisibilityConverter x:Key="Card.BoolToVisibility" />

  <DataTemplate DataType="{x:Type version:VersionCardViewModel}">
    <Border Style="{DynamicResource Settings.Card}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Image Source="{StaticResource Brand.Logo}" Width="40" Height="40" VerticalAlignment="Center" Margin="0,0,14,0" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
          <TextBlock Text="{Binding VersionText}" Style="{DynamicResource Settings.Label}" FontWeight="SemiBold" />
          <TextBlock Text="{Binding StatusText}" Style="{DynamicResource Settings.Hint}" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
        <Button Grid.Column="2" Style="{DynamicResource Settings.Button}" Content="{loc:T version.check}"
                Command="{Binding CheckCommand}"
                Visibility="{Binding ShowCheck, Converter={StaticResource Card.BoolToVisibility}}" />
      </Grid>
    </Border>
  </DataTemplate>

</ResourceDictionary>
