<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Atap.Ui.Controls"
                    xmlns:local="clr-namespace:Atap.Widgets.JsonUrl">

  <!-- Notch templates get a PlacementViewModel. The widget view model is in .ViewModel.
       The value itself uses the shared "value.<Kind>" templates from Ui/Controls/Values.xaml.
       Merged only while a JSON URL instance exists, which is also when its settings form can open. Nothing in it animates. -->

  <BooleanToVisibilityConverter x:Key="json-url.visible" />

  <local:JsonUrlTesterFor x:Key="json-url.testerFor" />

  <!-- Compact, left of the camera: a status dot and the name. Shown only while the value needs attention. -->
  <DataTemplate x:Key="json-url.Compact.Left">
    <StackPanel DataContext="{Binding ViewModel}"
                AutomationProperties.Name="{Binding AccessibleSummary}"
                Orientation="Horizontal"
                VerticalAlignment="Center"
                Margin="4,0">
      <controls:StatusDot Level="{Binding Level}" VerticalAlignment="Center" Margin="0,0,6,0" />
      <TextBlock Text="{Binding Title}"
                 Foreground="{DynamicResource PrimaryTextBrush}"
                 FontSize="13"
                 FontWeight="SemiBold"
                 MaxWidth="120"
                 TextTrimming="CharacterEllipsis"
                 VerticalAlignment="Center" />
    </StackPanel>
  </DataTemplate>

  <!-- Compact, right of the camera: the value, such as "91%". -->
  <DataTemplate x:Key="json-url.Compact.Right">
    <TextBlock DataContext="{Binding ViewModel}"
               AutomationProperties.Name="{Binding AccessibleSummary}"
               Text="{Binding CompactText}"
               Foreground="{DynamicResource PrimaryTextBrush}"
               FontSize="13"
               FontWeight="SemiBold"
               MaxWidth="140"
               TextTrimming="CharacterEllipsis"
               VerticalAlignment="Center"
               Margin="4,0" />
  </DataTemplate>

  <!-- The name, then the value as Number, Text, Bar, List or Status dot, with "Out of date" after a failed refresh. -->
  <DataTemplate x:Key="json-url.Expanded">
    <controls:WidgetCard DataContext="{Binding ViewModel}"
                         Header="{Binding Title}"
                         Icon="{DynamicResource icon.globe}"
                         Accent="{DynamicResource CustomAccentBrush}"
                         AutomationProperties.Name="{Binding AccessibleSummary}">
      <StackPanel>
        <ContentPresenter Content="{Binding Value}"
                          ContentTemplateSelector="{DynamicResource value.selector}"
                          Visibility="{Binding HasValue, Converter={StaticResource json-url.visible}}" />
        <TextBlock Text="{Binding Message}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap"
                   Visibility="{Binding HasMessage, Converter={StaticResource json-url.visible}}" />
      </StackPanel>
    </controls:WidgetCard>
  </DataTemplate>

  <DataTemplate x:Key="json-url.Panel">
    <ContentPresenter Content="{Binding}"
                      ContentTemplate="{StaticResource json-url.Expanded}"
                      AutomationProperties.Name="{Binding ViewModel.AccessibleSummary}" />
  </DataTemplate>

  <!-- Settings: the Test button. A 6 px rounded accent button, as in the rest of the settings window. -->
  <Style x:Key="json-url.testButton" TargetType="Button">
    <Setter Property="FocusVisualStyle" Value="{DynamicResource Settings.FocusVisual}" />
    <Setter Property="Background" Value="{DynamicResource ToggleOnBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ToggleOnBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource SettingsCardBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="12,5" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="MinWidth" Value="80" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}"
                  SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="Opacity" Value="0.9" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Chrome" Property="Opacity" Value="0.8" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Settings: the editor for the "test" field. It gets the CustomField and builds a JsonUrlTester from it.
       The preview sits on the notch colour, so it looks as it will on the notch. -->
  <DataTemplate x:Key="json-url.tester">
    <StackPanel DataContext="{Binding Converter={StaticResource json-url.testerFor}}"
                AutomationProperties.Name="{Binding Label}">
      <Button Style="{StaticResource json-url.testButton}"
              Command="{Binding TestCommand}"
              AutomationProperties.Name="{Binding ButtonText}"
              AutomationProperties.HelpText="{Binding Label}">
        <TextBlock Text="{Binding ButtonText}" />
      </Button>
      <TextBlock Text="{Binding Status}"
                 Style="{DynamicResource Settings.Hint}"
                 Margin="0,8,0,0"
                 AutomationProperties.LiveSetting="Polite" />
      <Border Background="{DynamicResource NotchSurfaceBrush}"
              CornerRadius="8"
              Padding="14,10"
              Margin="0,8,0,0"
              MinWidth="220"
              MaxWidth="360"
              HorizontalAlignment="Left"
              Visibility="{Binding HasPreview, Converter={StaticResource json-url.visible}}">
        <ContentPresenter Content="{Binding Preview}" ContentTemplateSelector="{DynamicResource value.selector}" />
      </Border>
      <StackPanel Margin="0,12,0,0" Visibility="{Binding HasSample, Converter={StaticResource json-url.visible}}">
        <TextBlock Text="{Binding SampleTitle}" Style="{DynamicResource Settings.Label}" FontSize="12" FontWeight="SemiBold" />
        <Border BorderBrush="{DynamicResource SettingsCardBorderBrush}" BorderThickness="1" CornerRadius="6" Margin="0,4,0,0" MaxHeight="220">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" Padding="10,8">
            <TextBlock Text="{Binding Sample}"
                       FontFamily="Cascadia Mono, Consolas"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource InkSecondaryBrush}"
                       AutomationProperties.Name="{Binding SampleTitle}" />
          </ScrollViewer>
        </Border>
      </StackPanel>
    </StackPanel>
  </DataTemplate>

</ResourceDictionary>
