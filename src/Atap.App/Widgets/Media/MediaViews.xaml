<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:loc="clr-namespace:Atap.Ui.Localization">

  <!-- Templates get a PlacementViewModel; the MediaViewModel is in .ViewModel.
       Merged only while a media instance exists. -->

  <!-- Compact, left slot: album art, or a music-note placeholder. -->
  <DataTemplate x:Key="media.Compact.Left">
    <Grid DataContext="{Binding ViewModel}"
          AutomationProperties.Name="{Binding AccessibleSummary}"
          Width="22"
          Height="22"
          VerticalAlignment="Center">
      <Border CornerRadius="5" Background="{DynamicResource PlaceholderBrush}">
        <TextBlock Text="&#xE8D6;"
                   FontFamily="{StaticResource IconFont}"
                   FontSize="11"
                   Foreground="{DynamicResource SecondaryTextBrush}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center" />
      </Border>
      <Border CornerRadius="5">
        <Border.Background>
          <ImageBrush ImageSource="{Binding AlbumArt}" Stretch="UniformToFill" />
        </Border.Background>
      </Border>
    </Grid>
  </DataTemplate>

  <!-- Compact, right slot: static "playing" bars (no looping animation, by design). -->
  <DataTemplate x:Key="media.Compact.Right">
    <StackPanel DataContext="{Binding ViewModel}"
                AutomationProperties.Name="{Binding AccessibleSummary}"
                Orientation="Horizontal"
                Height="14"
                VerticalAlignment="Center"
                Margin="2,0">
      <StackPanel.Style>
        <Style TargetType="StackPanel">
          <Style.Triggers>
            <DataTrigger Binding="{Binding IsPlaying}" Value="False">
              <Setter Property="Opacity" Value="0.4" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </StackPanel.Style>
      <Rectangle Width="3" Height="7" Margin="1,0" RadiusX="1.5" RadiusY="1.5" VerticalAlignment="Bottom" Fill="{DynamicResource AccentBrush}" />
      <Rectangle Width="3" Height="13" Margin="1,0" RadiusX="1.5" RadiusY="1.5" VerticalAlignment="Bottom" Fill="{DynamicResource AccentBrush}" />
      <Rectangle Width="3" Height="9" Margin="1,0" RadiusX="1.5" RadiusY="1.5" VerticalAlignment="Bottom" Fill="{DynamicResource AccentBrush}" />
    </StackPanel>
  </DataTemplate>

  <!-- Expanded, medium: art, title, artist and transport buttons. -->
  <DataTemplate x:Key="media.Expanded.Medium">
    <Grid DataContext="{Binding ViewModel}"
          AutomationProperties.Name="{Binding AccessibleSummary}"
          Margin="2,4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Grid Width="64" Height="64" VerticalAlignment="Center">
        <Border CornerRadius="10" Background="{DynamicResource PlaceholderBrush}">
          <TextBlock Text="&#xE8D6;"
                     FontFamily="{StaticResource IconFont}"
                     FontSize="24"
                     Foreground="{DynamicResource SecondaryTextBrush}"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center" />
        </Border>
        <Border CornerRadius="10">
          <Border.Background>
            <ImageBrush ImageSource="{Binding AlbumArt}" Stretch="UniformToFill" />
          </Border.Background>
        </Border>
      </Grid>

      <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
        <TextBlock Text="{Binding Title}"
                   Foreground="{DynamicResource PrimaryTextBrush}"
                   FontSize="14"
                   FontWeight="SemiBold"
                   TextTrimming="CharacterEllipsis" />
        <TextBlock Text="{Binding Artist}"
                   Foreground="{DynamicResource SecondaryTextBrush}"
                   FontSize="12"
                   TextTrimming="CharacterEllipsis" />

        <StackPanel Orientation="Horizontal" Margin="-6,4,0,0">
          <Button Style="{StaticResource IconButton}"
                  Command="{Binding PreviousCommand}"
                  Content="&#xE892;"
                  ToolTip="{loc:T media.previous}"
                  AutomationProperties.Name="{loc:T media.previous}" />
          <Button Command="{Binding PlayPauseCommand}"
                  ToolTip="{loc:T media.playPause}"
                  AutomationProperties.Name="{loc:T media.playPause}">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                <Setter Property="Content" Value="&#xE768;" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                    <Setter Property="Content" Value="&#xE769;" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
          </Button>
          <Button Style="{StaticResource IconButton}"
                  Command="{Binding NextCommand}"
                  Content="&#xE893;"
                  ToolTip="{loc:T media.next}"
                  AutomationProperties.Name="{loc:T media.next}" />
        </StackPanel>
      </StackPanel>
    </Grid>
  </DataTemplate>

  <!-- The panel shows the same card as the open notch. -->
  <DataTemplate x:Key="media.Panel.Medium">
    <ContentPresenter Content="{Binding}"
                      ContentTemplate="{StaticResource media.Expanded.Medium}"
                      AutomationProperties.Name="{Binding ViewModel.AccessibleSummary}" />
  </DataTemplate>

</ResourceDictionary>
