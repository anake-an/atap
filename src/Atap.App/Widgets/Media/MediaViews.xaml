<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:loc="clr-namespace:Atap.Ui.Localization"
                    xmlns:controls="clr-namespace:Atap.Ui.Controls"
                    xmlns:media="clr-namespace:Atap.Widgets.Media">

  <!-- Templates get a PlacementViewModel; the MediaViewModel is in .ViewModel.
       Merged only while a media instance exists. -->

  <BooleanToVisibilityConverter x:Key="media.visible" />

  <!-- Compact, left slot: album art, or a music-note placeholder. -->
  <DataTemplate x:Key="media.Compact.Left">
    <Grid DataContext="{Binding ViewModel}"
          AutomationProperties.Name="{Binding AccessibleSummary}"
          Width="22"
          Height="22"
          VerticalAlignment="Center">
      <Border CornerRadius="6" Background="{DynamicResource PlaceholderBrush}">
        <TextBlock Text="&#xE8D6;"
                   FontFamily="{StaticResource IconFont}"
                   FontSize="11"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center" />
      </Border>
      <Border CornerRadius="6">
        <Border.Background>
          <ImageBrush ImageSource="{Binding AlbumArt}" Stretch="UniformToFill" />
        </Border.Background>
      </Border>
    </Grid>
  </DataTemplate>

  <!-- Compact, right slot: the "playing" bars, in the album colour. They bounce only while playing and shown, and
       stand still with less motion or battery saver (the notch's LessMotion), see MediaPlayingBars. Dim while
       paused. High contrast keeps the system colour. -->
  <DataTemplate x:Key="media.Compact.Right">
    <media:MediaPlayingBars DataContext="{Binding ViewModel}"
                            AutomationProperties.Name="{Binding AccessibleSummary}"
                            IsPlaying="{Binding IsPlaying}"
                            IsCalm="{Binding DataContext.LessMotion, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=False}"
                            Height="14"
                            VerticalAlignment="Center"
                            Margin="2,0">
      <media:MediaPlayingBars.Style>
        <Style TargetType="media:MediaPlayingBars">
          <Style.Triggers>
            <DataTrigger Binding="{Binding IsPlaying}" Value="False">
              <Setter Property="Opacity" Value="0.4" />
            </DataTrigger>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Binding="{Binding HasAlbumColour}" Value="True" />
                <Condition Binding="{Binding IsHigh, Source={x:Static controls:Contrast.Current}}" Value="False" />
              </MultiDataTrigger.Conditions>
              <Setter Property="Accent" Value="{Binding AlbumBrush}" />
            </MultiDataTrigger>
          </Style.Triggers>
        </Style>
      </media:MediaPlayingBars.Style>
    </media:MediaPlayingBars>
  </DataTemplate>

  <!-- Compact, in the middle: the song title and a muted "· Artist", or the lyric line playing now when the setting
       asks for it. A line too long scrolls slowly while shown, see MediaMarquee. Under it, a faint line in the album
       colour shows how far the song is. The notch makes this placement itself for the middle of the small notch.
       On a side edge the upright tab keeps only the art and the bars, so this is left out there. -->
  <DataTemplate x:Key="media.Compact.Center">
    <Grid DataContext="{Binding ViewModel}"
          AutomationProperties.Name="{Binding AccessibleSummary}"
          media:MediaShownReport.IsOn="True"
          MaxWidth="180"
          Margin="8,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="0" />
      </Grid.RowDefinitions>
      <Grid.Style>
        <Style TargetType="Grid">
          <Style.Triggers>
            <DataTrigger Binding="{Binding DataContext.IsVertical, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=False}" Value="True">
              <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Grid.Style>

      <media:MediaMarquee HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          IsCalm="{Binding DataContext.LessMotion, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=False}">
        <TextBlock FontSize="12"
                   Foreground="{DynamicResource TextBrush}"
                   TextWrapping="NoWrap"
                   TextTrimming="CharacterEllipsis">
          <Run Text="{Binding CompactText, Mode=OneWay}"
               FontWeight="SemiBold" /><Run Text="{Binding CompactDetail, Mode=OneWay}"
                                            Foreground="{DynamicResource TextSecondaryBrush}" />
        </TextBlock>
      </media:MediaMarquee>

      <!-- The faint line lies over the notch's bottom padding, a few pixels above the edge, in a row of no height,
           so the notch keeps its usual height. It runs from the art to the bars. The played part
           moves once a second while the small notch shows it and the song plays. -->
      <Grid Grid.Row="1"
            Height="2"
            VerticalAlignment="Top"
            Margin="-8,6,-8,-8">
        <Border CornerRadius="1" Opacity="0.3">
          <Border.Style>
            <Style TargetType="Border">
              <Setter Property="Background" Value="{DynamicResource MediaAccentBrush}" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding HasAlbumColour}" Value="True">
                  <Setter Property="Background" Value="{Binding AlbumBrush}" />
                </DataTrigger>
                <!-- High contrast: the progress line's own track and system colours show instead. -->
                <DataTrigger Binding="{Binding IsHigh, Source={x:Static controls:Contrast.Current}}" Value="True">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
        </Border>
        <controls:ProgressPill Value="{Binding Progress, Mode=OneWay}"
                               Maximum="100"
                               Background="Transparent"
                               AutomationProperties.Name="{loc:T media.progress}"
                               Visibility="{Binding HasProgress, Converter={StaticResource media.visible}}">
          <controls:ProgressPill.Style>
            <Style TargetType="controls:ProgressPill" BasedOn="{StaticResource {x:Type controls:ProgressPill}}">
              <Setter Property="Accent" Value="{DynamicResource MediaAccentBrush}" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding HasAlbumColour}" Value="True">
                  <Setter Property="Accent" Value="{Binding AlbumBrush}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </controls:ProgressPill.Style>
        </controls:ProgressPill>
      </Grid>
    </Grid>
  </DataTemplate>

  <!-- Expanded, medium: art, title, artist and transport buttons. -->
  <DataTemplate x:Key="media.Expanded.Medium">
    <Grid DataContext="{Binding ViewModel}"
          AutomationProperties.Name="{Binding AccessibleSummary}"
          Margin="2,4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Grid Width="64" Height="64" VerticalAlignment="Center">
        <Border CornerRadius="8" Background="{DynamicResource PlaceholderBrush}">
          <TextBlock Text="&#xE8D6;"
                     FontFamily="{StaticResource IconFont}"
                     FontSize="24"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center" />
        </Border>
        <Border CornerRadius="8">
          <Border.Background>
            <ImageBrush ImageSource="{Binding AlbumArt}" Stretch="UniformToFill" />
          </Border.Background>
        </Border>
      </Grid>

      <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
        <TextBlock Text="{Binding Title}"
                   Foreground="{DynamicResource TextBrush}"
                   FontSize="14"
                   FontWeight="SemiBold"
                   TextTrimming="CharacterEllipsis" />
        <TextBlock Text="{Binding Artist}"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   FontSize="12"
                   TextTrimming="CharacterEllipsis" />

        <StackPanel Orientation="Horizontal" Margin="-6,4,0,0">
          <Button Style="{StaticResource IconButton}"
                  Command="{Binding PreviousCommand}"
                  Content="&#xE892;"
                  ToolTip="{loc:T media.previous}"
                  AutomationProperties.Name="{loc:T media.previous}" />
          <Button Command="{Binding PlayPauseCommand}"
                  ToolTip="{loc:T media.playPause}"
                  AutomationProperties.Name="{loc:T media.playPause}">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                <Setter Property="Content" Value="&#xE768;" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                    <Setter Property="Content" Value="&#xE769;" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
          </Button>
          <Button Style="{StaticResource IconButton}"
                  Command="{Binding NextCommand}"
                  Content="&#xE893;"
                  ToolTip="{loc:T media.next}"
                  AutomationProperties.Name="{loc:T media.next}" />
        </StackPanel>
      </StackPanel>

      <!-- How far through the song. It moves once a second while open and playing, and is left out when the
           player gives no length. -->
      <controls:ProgressPill Grid.Row="1"
                             Grid.ColumnSpan="2"
                             Height="3"
                             Margin="0,8,0,0"
                             Value="{Binding Progress, Mode=OneWay}"
                             Maximum="100"
                             Accent="{DynamicResource MediaAccentBrush}"
                             AutomationProperties.Name="{loc:T media.progress}"
                             Visibility="{Binding HasProgress, Converter={StaticResource media.visible}}" />
    </Grid>
  </DataTemplate>

  <!-- The panel shows the same card as the open notch. -->
  <DataTemplate x:Key="media.Panel.Medium">
    <ContentPresenter Content="{Binding}"
                      ContentTemplate="{StaticResource media.Expanded.Medium}"
                      AutomationProperties.Name="{Binding ViewModel.AccessibleSummary}" />
  </DataTemplate>

</ResourceDictionary>
