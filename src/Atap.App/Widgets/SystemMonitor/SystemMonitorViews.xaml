<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Atap.Ui.Controls"
                    xmlns:loc="clr-namespace:Atap.Ui.Localization">

  <!-- Templates get a PlacementViewModel. The widget view model is in .ViewModel.
       Merged only while a system monitor instance exists. Nothing in it animates. -->

  <DataTemplate x:Key="system-monitor.Expanded">
    <controls:WidgetCard DataContext="{Binding ViewModel}" Header="{loc:T sysmon.name}" Icon="{DynamicResource icon.cpu}"
                         Accent="{DynamicResource SystemAccentBrush}" AutomationProperties.Name="{Binding AccessibleSummary}">
      <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <StackPanel Margin="0,0,0,8" AutomationProperties.Name="{Binding Name}">
              <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" Foreground="{DynamicResource TextBrush}" FontSize="12"
                           FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" />
                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
              </DockPanel>
              <controls:ProgressPill Value="{Binding Percent, Mode=OneWay}" Maximum="100" Level="{Binding Level, Mode=OneWay}"
                                     Accent="{DynamicResource SystemAccentBrush}" Margin="0,4,0,0" AutomationProperties.Name="{Binding Name}" />
              <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,2,0,0" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </controls:WidgetCard>
  </DataTemplate>

  <DataTemplate x:Key="system-monitor.Panel">
    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource system-monitor.Expanded}"
                      AutomationProperties.Name="{Binding ViewModel.AccessibleSummary}" />
  </DataTemplate>

</ResourceDictionary>
