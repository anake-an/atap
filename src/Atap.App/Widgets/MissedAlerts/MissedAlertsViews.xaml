<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:loc="clr-namespace:Atap.Ui.Localization"
                    xmlns:automation="clr-namespace:Atap.Notch.Automation">

  <!-- Templates get a PlacementViewModel. The widget view model is in .ViewModel.
       Merged only while a missed-alerts instance exists. Nothing in it animates. -->

  <BooleanToVisibilityConverter x:Key="missed-alerts.visible" />

  <!-- One missed alert: title and time, with the detail line below. -->
  <DataTemplate x:Key="missed-alerts.item">
    <Grid Margin="0,6,0,0" AutomationProperties.Name="{Binding AccessibleName}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="{Binding Title}"
                   Foreground="{DynamicResource TextBrush}"
                   FontSize="12"
                   FontWeight="SemiBold"
                   TextTrimming="CharacterEllipsis" />
        <TextBlock Text="{Binding Subtitle}"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   FontSize="11"
                   TextTrimming="CharacterEllipsis"
                   Visibility="{Binding HasSubtitle, Converter={StaticResource missed-alerts.visible}}" />
      </StackPanel>
      <TextBlock Grid.Column="1"
                 Text="{Binding Time}"
                 Foreground="{DynamicResource TextMutedBrush}"
                 FontSize="11"
                 Margin="10,1,0,0"
                 VerticalAlignment="Top" />
    </Grid>
  </DataTemplate>

  <!-- The panel card: a heading with the count and Clear, then the list, newest first. -->
  <DataTemplate x:Key="missed-alerts">
    <Border DataContext="{Binding ViewModel}"
            AutomationProperties.Name="{Binding AccessibleSummary}"
            Background="{DynamicResource CardBrush}"
            CornerRadius="{DynamicResource CardCornerRadius}"
            Padding="12,10"
            MinWidth="200">
      <DockPanel>
        <DockPanel DockPanel.Dock="Top" LastChildFill="False">
          <TextBlock DockPanel.Dock="Left"
                     Text="{loc:T missed-alerts.title}"
                     Foreground="{DynamicResource TextBrush}"
                     FontSize="13"
                     FontWeight="SemiBold"
                     VerticalAlignment="Center" />
          <Border DockPanel.Dock="Left"
                  Background="{DynamicResource RaisedBrush}"
                  CornerRadius="8"
                  Padding="6,0"
                  Margin="8,0,0,0"
                  VerticalAlignment="Center"
                  Visibility="{Binding HasItems, Converter={StaticResource missed-alerts.visible}}">
            <TextBlock Text="{Binding CountText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" />
          </Border>
          <Button DockPanel.Dock="Right"
                  Focusable="{Binding (automation:KeyboardMode.IsOn), RelativeSource={RelativeSource Self}}"
                  FocusVisualStyle="{DynamicResource NotchFocusVisual}"
                  Cursor="Hand"
                  Content="{loc:T missed-alerts.clear}"
                  ToolTip="{loc:T missed-alerts.clearHint}"
                  AutomationProperties.Name="{loc:T missed-alerts.clearHint}"
                  Command="{Binding ClearCommand}"
                  Foreground="{DynamicResource TextSecondaryBrush}"
                  FontSize="11"
                  VerticalAlignment="Center"
                  Visibility="{Binding HasItems, Converter={StaticResource missed-alerts.visible}}">
            <Button.Template>
              <ControlTemplate TargetType="Button">
                <Border x:Name="Chrome" Background="Transparent" CornerRadius="8" Padding="8,2">
                  <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource RaisedBrush}" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Button.Template>
          </Button>
        </DockPanel>

        <TextBlock DockPanel.Dock="Top"
                   Text="{loc:T missed-alerts.empty}"
                   Foreground="{DynamicResource TextMutedBrush}"
                   FontSize="12"
                   Margin="0,8,0,2"
                   Visibility="{Binding IsEmpty, Converter={StaticResource missed-alerts.visible}}" />

        <ScrollViewer MaxHeight="160"
                      Focusable="False"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding HasItems, Converter={StaticResource missed-alerts.visible}}">
          <ItemsControl Focusable="False"
                        ItemsSource="{Binding Items}"
                        ItemTemplate="{StaticResource missed-alerts.item}" />
        </ScrollViewer>
      </DockPanel>
    </Border>
  </DataTemplate>

</ResourceDictionary>
