<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Atap.Ui.Controls"
                    xmlns:loc="clr-namespace:Atap.Ui.Localization">

  <!-- Templates get a PlacementViewModel. The widget view model is in .ViewModel.
       Merged only while a focus timer instance exists. Nothing in it animates: the time changes once a second
       while open, once a minute in the compact notch. -->

  <BooleanToVisibilityConverter x:Key="focus-timer.visible" />

  <!-- One button that starts, pauses and resumes. Its icon follows the state. -->
  <Style x:Key="focus-timer.toggle" TargetType="controls:IconButton" BasedOn="{StaticResource {x:Type controls:IconButton}}">
    <Setter Property="Icon" Value="{DynamicResource icon.play}" />
    <Setter Property="Label" Value="{Binding ToggleLabel}" />
    <Setter Property="Command" Value="{Binding ToggleCommand}" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsRunning}" Value="True">
        <Setter Property="Icon" Value="{DynamicResource icon.pause}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- Stop and start over, shown only once the timer has started (running or paused). -->
  <Style x:Key="focus-timer.reset" TargetType="controls:IconButton" BasedOn="{StaticResource {x:Type controls:IconButton}}">
    <Setter Property="Icon" Value="{DynamicResource icon.stop}" />
    <Setter Property="Label" Value="{loc:T focus.reset}" />
    <Setter Property="Command" Value="{Binding ResetCommand}" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsIdle}" Value="True">
        <Setter Property="Visibility" Value="Collapsed" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- Compact, left of the camera: the timer icon and the phase. On a side edge the notch is a slim upright
       tab, so only the icon shows here and the time and state stack under it. The notch window's view model
       says which edge it is on. -->
  <DataTemplate x:Key="focus-timer.Compact.Left">
    <StackPanel DataContext="{Binding ViewModel}"
                AutomationProperties.Name="{Binding AccessibleSummary}"
                Orientation="Horizontal"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Margin="4,0">
      <controls:StrokeIcon x:Name="Icon"
                           Data="{DynamicResource icon.timer}"
                           Foreground="{DynamicResource ProductivityAccentBrush}"
                           Width="14"
                           Height="14"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0" />
      <TextBlock x:Name="Phase"
                 Text="{Binding PhaseText}"
                 Foreground="{DynamicResource TextBrush}"
                 FontSize="13"
                 FontWeight="SemiBold"
                 VerticalAlignment="Center" />
    </StackPanel>
    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding DataContext.IsVertical, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
        <Setter TargetName="Phase" Property="Visibility" Value="Collapsed" />
        <Setter TargetName="Icon" Property="Margin" Value="0,2" />
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>

  <!-- Compact, right of the camera: "25 min", with a small "Paused" beside it while paused. On a side edge the
       time sits over the state, centred. -->
  <DataTemplate x:Key="focus-timer.Compact.Right">
    <StackPanel x:Name="Root"
                DataContext="{Binding ViewModel}"
                AutomationProperties.Name="{Binding AccessibleSummary}"
                Orientation="Horizontal"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Margin="4,0">
      <TextBlock Text="{Binding ShortText}"
                 Foreground="{DynamicResource TextBrush}"
                 FontSize="13"
                 FontWeight="SemiBold"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Typography.NumeralAlignment="Tabular" />
      <TextBlock x:Name="State"
                 Text="{Binding CompactState}"
                 Foreground="{DynamicResource TextSecondaryBrush}"
                 FontSize="11"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Margin="6,0,0,0"
                 Visibility="{Binding IsPaused, Converter={StaticResource focus-timer.visible}}" />
    </StackPanel>
    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding DataContext.IsVertical, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
        <Setter TargetName="Root" Property="Orientation" Value="Vertical" />
        <Setter TargetName="Root" Property="Margin" Value="0,2" />
        <Setter TargetName="State" Property="Margin" Value="0,1,0,0" />
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>

  <!-- Small: the phase, the time, the main button and, once started, stop. -->
  <DataTemplate x:Key="focus-timer.Expanded.Small">
    <controls:WidgetCard DataContext="{Binding ViewModel}"
                         Header="{loc:T focus.name}"
                         Icon="{DynamicResource icon.timer}"
                         Accent="{DynamicResource ProductivityAccentBrush}"
                         AutomationProperties.Name="{Binding AccessibleSummary}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="{Binding PhaseText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
          <TextBlock Text="{Binding TimeText}" Foreground="{DynamicResource TextBrush}" FontSize="24" FontWeight="SemiBold"
                     Typography.NumeralAlignment="Tabular" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <controls:IconButton Style="{StaticResource focus-timer.toggle}" />
          <controls:IconButton Style="{StaticResource focus-timer.reset}" Margin="4,0,0,0" />
        </StackPanel>
      </Grid>
    </controls:WidgetCard>
  </DataTemplate>

  <!-- Medium: the phase and session, the time, progress, and every action. -->
  <DataTemplate x:Key="focus-timer.Expanded">
    <controls:WidgetCard DataContext="{Binding ViewModel}"
                         Header="{loc:T focus.name}"
                         Icon="{DynamicResource icon.timer}"
                         Accent="{DynamicResource ProductivityAccentBrush}"
                         AutomationProperties.Name="{Binding AccessibleSummary}">
      <StackPanel>
        <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12">
          <Run Text="{Binding PhaseText, Mode=OneWay}" />
          <Run Text="·" />
          <Run Text="{Binding SessionText, Mode=OneWay}" />
        </TextBlock>
        <Grid Margin="0,2,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="{Binding TimeText}" Foreground="{DynamicResource TextBrush}" FontSize="30" FontWeight="SemiBold"
                     Typography.NumeralAlignment="Tabular" VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <controls:IconButton Style="{StaticResource focus-timer.toggle}" Margin="0,0,4,0" />
            <controls:IconButton Icon="{DynamicResource icon.plus}" Label="{loc:T focus.addTime}" Command="{Binding AddTimeCommand}" Margin="0,0,4,0" />
            <controls:IconButton Icon="{DynamicResource icon.next}" Label="{loc:T focus.skip}" Command="{Binding SkipCommand}" Margin="0,0,4,0" />
            <controls:IconButton Icon="{DynamicResource icon.stop}" Label="{loc:T focus.reset}" Command="{Binding ResetCommand}" />
          </StackPanel>
        </Grid>
        <controls:ProgressPill Value="{Binding Progress, Mode=OneWay}"
                               Maximum="100"
                               Margin="0,8,0,0"
                               Accent="{DynamicResource ProductivityAccentBrush}"
                               AutomationProperties.Name="{Binding PhaseText}" />
      </StackPanel>
    </controls:WidgetCard>
  </DataTemplate>

  <!-- The panel shows the same cards as the open notch. -->
  <DataTemplate x:Key="focus-timer.Panel.Small">
    <ContentPresenter Content="{Binding}"
                      ContentTemplate="{StaticResource focus-timer.Expanded.Small}"
                      AutomationProperties.Name="{Binding ViewModel.AccessibleSummary}" />
  </DataTemplate>

  <DataTemplate x:Key="focus-timer.Panel">
    <ContentPresenter Content="{Binding}"
                      ContentTemplate="{StaticResource focus-timer.Expanded}"
                      AutomationProperties.Name="{Binding ViewModel.AccessibleSummary}" />
  </DataTemplate>

</ResourceDictionary>
