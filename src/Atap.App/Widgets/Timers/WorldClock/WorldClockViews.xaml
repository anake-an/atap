<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Atap.Ui.Controls"
                    xmlns:loc="clr-namespace:Atap.Ui.Localization">

  <!-- Templates get a PlacementViewModel. The widget view model is in .ViewModel.
       Merged only while a world clock instance exists. Nothing in it animates. -->

  <BooleanToVisibilityConverter x:Key="world-clock.visible" />

  <DataTemplate x:Key="world-clock.none">
    <TextBlock Text="{loc:T worldclock.none}"
               AutomationProperties.Name="{loc:T worldclock.none}"
               Style="{DynamicResource card.Empty}" />
  </DataTemplate>

  <!-- Small: the first place, large. -->
  <DataTemplate x:Key="world-clock.Expanded.Small">
    <controls:WidgetCard DataContext="{Binding ViewModel}"
                         Header="{Binding First.City}"
                         Icon="{DynamicResource icon.globe}"
                         Accent="{DynamicResource ProductivityAccentBrush}"
                         AutomationProperties.Name="{Binding AccessibleSummary}">
      <Grid>
        <StackPanel Visibility="{Binding HasCities, Converter={StaticResource world-clock.visible}}">
          <TextBlock Text="{Binding First.Time}" Foreground="{DynamicResource TextBrush}" FontSize="24" FontWeight="SemiBold"
                     Typography.NumeralAlignment="Tabular" />
          <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12">
            <Run Text="{Binding First.Offset, Mode=OneWay}" />
            <Run Text="{Binding First.Day, Mode=OneWay}" />
          </TextBlock>
        </StackPanel>
        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource world-clock.none}"
                          Visibility="{Binding HasNoCities, Converter={StaticResource world-clock.visible}}" />
      </Grid>
    </controls:WidgetCard>
  </DataTemplate>

  <!-- Medium: up to three places, one per row. -->
  <DataTemplate x:Key="world-clock.Expanded">
    <controls:WidgetCard DataContext="{Binding ViewModel}"
                         Header="{loc:T worldclock.name}"
                         Icon="{DynamicResource icon.globe}"
                         Accent="{DynamicResource ProductivityAccentBrush}"
                         AutomationProperties.Name="{Binding AccessibleSummary}">
      <Grid>
        <ItemsControl ItemsSource="{Binding Rows}" Focusable="False"
                      Visibility="{Binding HasCities, Converter={StaticResource world-clock.visible}}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Margin="0,3" AutomationProperties.Name="{Binding City}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="{Binding City}" Foreground="{DynamicResource TextBrush}" FontSize="13" FontWeight="SemiBold"
                             TextTrimming="CharacterEllipsis" />
                  <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11">
                    <Run Text="{Binding Offset, Mode=OneWay}" />
                    <Run Text="{Binding Day, Mode=OneWay}" />
                  </TextBlock>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding Time}" Foreground="{DynamicResource TextBrush}" FontSize="18"
                           FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" VerticalAlignment="Center" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource world-clock.none}"
                          Visibility="{Binding HasNoCities, Converter={StaticResource world-clock.visible}}" />
      </Grid>
    </controls:WidgetCard>
  </DataTemplate>

  <DataTemplate x:Key="world-clock.Panel.Small">
    <ContentPresenter Content="{Binding}"
                      ContentTemplate="{StaticResource world-clock.Expanded.Small}"
                      AutomationProperties.Name="{Binding ViewModel.AccessibleSummary}" />
  </DataTemplate>

  <DataTemplate x:Key="world-clock.Panel">
    <ContentPresenter Content="{Binding}"
                      ContentTemplate="{StaticResource world-clock.Expanded}"
                      AutomationProperties.Name="{Binding ViewModel.AccessibleSummary}" />
  </DataTemplate>

</ResourceDictionary>
