<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Templates get a PlacementViewModel; the widget view model is in .ViewModel.
       Merged only while a clock instance exists.
       On the top edge the time reads across. On a side edge the notch is a slim upright tab, so the hours
       sit over the minutes. The notch window's view model says which edge it is on. -->
  <DataTemplate x:Key="clock">
    <Grid DataContext="{Binding ViewModel}"
          AutomationProperties.Name="{Binding AccessibleSummary}"
          HorizontalAlignment="Center"
          VerticalAlignment="Center">
      <TextBlock x:Name="Across"
                 Text="{Binding Time}"
                 Foreground="{DynamicResource TextBrush}"
                 FontSize="13"
                 FontWeight="SemiBold"
                 Margin="4,0" />
      <StackPanel x:Name="Stacked" Visibility="Collapsed" HorizontalAlignment="Center">
        <TextBlock Text="{Binding Hours}"
                   Foreground="{DynamicResource TextBrush}"
                   FontSize="13"
                   FontWeight="SemiBold"
                   HorizontalAlignment="Center" />
        <TextBlock Text="{Binding Minutes}"
                   Foreground="{DynamicResource TextBrush}"
                   FontSize="13"
                   FontWeight="SemiBold"
                   HorizontalAlignment="Center"
                   Margin="0,1,0,0" />
      </StackPanel>
    </Grid>
    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding DataContext.IsVertical, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
        <Setter TargetName="Across" Property="Visibility" Value="Collapsed" />
        <Setter TargetName="Stacked" Property="Visibility" Value="Visible" />
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>

</ResourceDictionary>
