<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Atap.Ui.Controls">

  <!-- Templates get a PlacementViewModel. The widget view model is in .ViewModel.
       Merged only while a Home Assistant instance exists. Nothing in it animates.
       The value itself uses the shared value.<Kind> templates from Values.xaml. -->

  <BooleanToVisibilityConverter x:Key="home-assistant.visible" />

  <!-- Compact, left of the camera: a house and the name, while the value is past its alert level. -->
  <DataTemplate x:Key="home-assistant.Compact.Left">
    <StackPanel DataContext="{Binding ViewModel}"
                AutomationProperties.Name="{Binding AccessibleSummary}"
                Orientation="Horizontal"
                VerticalAlignment="Center"
                Margin="4,0">
      <controls:StrokeIcon Data="{DynamicResource icon.home}"
                           Foreground="{DynamicResource CustomAccentBrush}"
                           Width="16"
                           Height="16"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0" />
      <TextBlock Text="{Binding Title}"
                 Foreground="{DynamicResource PrimaryTextBrush}"
                 FontSize="13"
                 FontWeight="SemiBold"
                 MaxWidth="140"
                 TextTrimming="CharacterEllipsis"
                 VerticalAlignment="Center" />
    </StackPanel>
  </DataTemplate>

  <!-- Compact, right of the camera: a level dot and "31.5 °C". -->
  <DataTemplate x:Key="home-assistant.Compact.Right">
    <StackPanel DataContext="{Binding ViewModel}"
                AutomationProperties.Name="{Binding AccessibleSummary}"
                Orientation="Horizontal"
                VerticalAlignment="Center"
                Margin="4,0">
      <controls:StatusDot Level="{Binding Level}" VerticalAlignment="Center" Margin="0,0,6,0" />
      <TextBlock Text="{Binding CompactText}"
                 Foreground="{DynamicResource PrimaryTextBrush}"
                 FontSize="13"
                 FontWeight="SemiBold"
                 MaxWidth="120"
                 TextTrimming="CharacterEllipsis"
                 Typography.NumeralAlignment="Tabular"
                 VerticalAlignment="Center" />
    </StackPanel>
  </DataTemplate>

  <!-- The name, then the value as a number, text, bar or status light, or a plain sentence until there is one. -->
  <DataTemplate x:Key="home-assistant.Expanded">
    <controls:WidgetCard DataContext="{Binding ViewModel}"
                         Header="{Binding Title}"
                         Icon="{DynamicResource icon.home}"
                         Accent="{DynamicResource CustomAccentBrush}"
                         AutomationProperties.Name="{Binding AccessibleSummary}">
      <Grid>
        <ContentPresenter Content="{Binding Value}"
                          ContentTemplateSelector="{DynamicResource value.selector}"
                          Visibility="{Binding HasValue, Converter={StaticResource home-assistant.visible}}" />
        <TextBlock Text="{Binding Message}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap"
                   Visibility="{Binding ShowMessage, Converter={StaticResource home-assistant.visible}}" />
      </Grid>
    </controls:WidgetCard>
  </DataTemplate>

  <DataTemplate x:Key="home-assistant.Panel">
    <ContentPresenter Content="{Binding}"
                      ContentTemplate="{StaticResource home-assistant.Expanded}"
                      AutomationProperties.Name="{Binding ViewModel.AccessibleSummary}" />
  </DataTemplate>

</ResourceDictionary>
