<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Atap.Ui.Controls"
                    xmlns:loc="clr-namespace:Atap.Ui.Localization">

  <!-- Templates get a PlacementViewModel. The widget view model is in .ViewModel.
       Merged only while an assignments instance exists. Nothing in it animates. -->

  <BooleanToVisibilityConverter x:Key="assignments.visible" />

  <Style x:Key="assignments.check" TargetType="CheckBox">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{DynamicResource focus.round}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Border Width="16" Height="16" CornerRadius="8" BorderThickness="1.5" BorderBrush="{DynamicResource TextSecondaryBrush}" Background="Transparent" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <DataTemplate x:Key="assignments.row">
    <Grid Margin="0,3" AutomationProperties.Name="{Binding Title}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <CheckBox Style="{StaticResource assignments.check}" Command="{Binding Done}" VerticalAlignment="Center" Margin="0,0,8,0"
                AutomationProperties.Name="{loc:T assignments.markDone}" ToolTip="{loc:T assignments.markDone}" />
      <StackPanel Grid.Column="1">
        <TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextBrush}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
        <TextBlock Text="{Binding Course}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis"
                   Visibility="{Binding HasCourse, Converter={StaticResource assignments.visible}}" />
      </StackPanel>
      <TextBlock x:Name="When" Grid.Column="2" Text="{Binding Countdown}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"
                 VerticalAlignment="Center" Margin="8,0,0,0" />
    </Grid>
    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding Urgent}" Value="True">
        <Setter TargetName="When" Property="Foreground" Value="{DynamicResource ProductivityAccentBrush}" />
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>

  <DataTemplate x:Key="assignments.Expanded.Small">
    <controls:WidgetCard DataContext="{Binding ViewModel}" Header="{loc:T assignments.name}" Icon="{DynamicResource icon.clipboard}"
                         Accent="{DynamicResource ProductivityAccentBrush}" AutomationProperties.Name="{Binding AccessibleSummary}">
      <Grid>
        <StackPanel Visibility="{Binding HasRows, Converter={StaticResource assignments.visible}}">
          <TextBlock Text="{Binding First.Title}" Foreground="{DynamicResource TextBrush}" FontSize="14" FontWeight="SemiBold"
                     TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding First.Countdown}" Foreground="{DynamicResource ProductivityAccentBrush}" FontSize="12" Margin="0,2,0,0" />
        </StackPanel>
        <TextBlock Text="{loc:T assignments.none}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap"
                   Visibility="{Binding HasNone, Converter={StaticResource assignments.visible}}" />
      </Grid>
    </controls:WidgetCard>
  </DataTemplate>

  <DataTemplate x:Key="assignments.Expanded">
    <controls:WidgetCard DataContext="{Binding ViewModel}" Header="{loc:T assignments.name}" Icon="{DynamicResource icon.clipboard}"
                         Accent="{DynamicResource ProductivityAccentBrush}" AutomationProperties.Name="{Binding AccessibleSummary}">
      <Grid>
        <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource assignments.row}" Focusable="False"
                      Visibility="{Binding HasRows, Converter={StaticResource assignments.visible}}" />
        <TextBlock Text="{loc:T assignments.none}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap"
                   Visibility="{Binding HasNone, Converter={StaticResource assignments.visible}}" />
      </Grid>
    </controls:WidgetCard>
  </DataTemplate>

  <DataTemplate x:Key="assignments.Panel.Small">
    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource assignments.Expanded.Small}"
                      AutomationProperties.Name="{Binding ViewModel.AccessibleSummary}" />
  </DataTemplate>

  <DataTemplate x:Key="assignments.Panel">
    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource assignments.Expanded}"
                      AutomationProperties.Name="{Binding ViewModel.AccessibleSummary}" />
  </DataTemplate>

</ResourceDictionary>
