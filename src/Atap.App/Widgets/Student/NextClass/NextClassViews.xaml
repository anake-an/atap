<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Atap.Ui.Controls"
                    xmlns:loc="clr-namespace:Atap.Ui.Localization">

  <!-- Templates get a PlacementViewModel. The widget view model is in .ViewModel.
       Merged only while a next class instance exists. Nothing in it animates. -->

  <BooleanToVisibilityConverter x:Key="next-class.visible" />

  <!-- Compact, left of the camera: the course code. -->
  <DataTemplate x:Key="next-class.Compact.Left">
    <StackPanel DataContext="{Binding ViewModel}" AutomationProperties.Name="{Binding AccessibleSummary}"
                Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0">
      <controls:StrokeIcon Data="{DynamicResource icon.calendar}" Foreground="{DynamicResource ProductivityAccentBrush}"
                           Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0" />
      <TextBlock Text="{Binding Short}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="13" FontWeight="SemiBold"
                 VerticalAlignment="Center" MaxWidth="120" TextTrimming="CharacterEllipsis" />
    </StackPanel>
  </DataTemplate>

  <!-- Compact, right of the camera: "12 min" before it starts, then the room. -->
  <DataTemplate x:Key="next-class.Compact.Right">
    <TextBlock DataContext="{Binding ViewModel}" AutomationProperties.Name="{Binding AccessibleSummary}"
               Text="{Binding CompactRight}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="13" FontWeight="SemiBold"
               VerticalAlignment="Center" Margin="4,0" MaxWidth="120" TextTrimming="CharacterEllipsis" />
  </DataTemplate>

  <DataTemplate x:Key="next-class.message">
    <TextBlock Text="{Binding Message}" AutomationProperties.Name="{Binding Message}"
               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
  </DataTemplate>

  <!-- The class: name, time, room and countdown. -->
  <DataTemplate x:Key="next-class.head">
    <StackPanel AutomationProperties.Name="{Binding AccessibleSummary}">
      <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBrush}" FontSize="15" FontWeight="SemiBold"
                 TextWrapping="Wrap" MaxHeight="42" TextTrimming="CharacterEllipsis" />
      <TextBlock Text="{Binding Time}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,2,0,0" />
      <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
        <Border Padding="8,2" CornerRadius="6" Background="{DynamicResource RaisedBrush}" Margin="0,0,6,0"
                Visibility="{Binding HasRoom, Converter={StaticResource next-class.visible}}">
          <TextBlock Text="{Binding Room}" Foreground="{DynamicResource TextBrush}" FontSize="11" />
        </Border>
        <TextBlock Text="{Binding Countdown}" Foreground="{DynamicResource ProductivityAccentBrush}" FontSize="12"
                   FontWeight="SemiBold" VerticalAlignment="Center" />
      </StackPanel>
    </StackPanel>
  </DataTemplate>

  <DataTemplate x:Key="next-class.Expanded.Small">
    <controls:WidgetCard DataContext="{Binding ViewModel}" Header="{loc:T nextclass.name}" Icon="{DynamicResource icon.calendar}"
                         Accent="{DynamicResource ProductivityAccentBrush}" AutomationProperties.Name="{Binding AccessibleSummary}">
      <Grid>
        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource next-class.head}"
                          Visibility="{Binding HasClass, Converter={StaticResource next-class.visible}}" />
        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource next-class.message}"
                          Visibility="{Binding HasMessage, Converter={StaticResource next-class.visible}}" />
      </Grid>
    </controls:WidgetCard>
  </DataTemplate>

  <!-- Medium: the class, then the rest of today. -->
  <DataTemplate x:Key="next-class.Expanded">
    <controls:WidgetCard DataContext="{Binding ViewModel}" Header="{loc:T nextclass.name}" Icon="{DynamicResource icon.calendar}"
                         Accent="{DynamicResource ProductivityAccentBrush}" AutomationProperties.Name="{Binding AccessibleSummary}">
      <Grid>
        <StackPanel Visibility="{Binding HasClass, Converter={StaticResource next-class.visible}}">
          <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource next-class.head}" />
          <StackPanel Margin="0,10,0,0" Visibility="{Binding HasLater, Converter={StaticResource next-class.visible}}">
            <TextBlock Text="{loc:T nextclass.laterToday}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,0,0,2" />
            <ItemsControl ItemsSource="{Binding Later}" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,1" AutomationProperties.Name="{Binding Name}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Time}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,8,0" />
                    <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{DynamicResource TextBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2" Text="{Binding Room}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="8,0,0,0" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </StackPanel>
        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource next-class.message}"
                          Visibility="{Binding HasMessage, Converter={StaticResource next-class.visible}}" />
      </Grid>
    </controls:WidgetCard>
  </DataTemplate>

  <DataTemplate x:Key="next-class.Panel.Small">
    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource next-class.Expanded.Small}"
                      AutomationProperties.Name="{Binding ViewModel.AccessibleSummary}" />
  </DataTemplate>

  <DataTemplate x:Key="next-class.Panel">
    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource next-class.Expanded}"
                      AutomationProperties.Name="{Binding ViewModel.AccessibleSummary}" />
  </DataTemplate>

</ResourceDictionary>
