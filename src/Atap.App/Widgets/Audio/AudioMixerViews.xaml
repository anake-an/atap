<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Atap.Ui.Controls"
                    xmlns:loc="clr-namespace:Atap.Ui.Localization">

  <!-- Templates get a PlacementViewModel. The widget view model is in .ViewModel.
       Shared by the output and mixer widgets. Nothing in it animates. -->

  <BooleanToVisibilityConverter x:Key="audio-mixer.visible" />

  <!-- The mixer: each app with quieter, louder and mute. -->
  <DataTemplate x:Key="audio-mixer.Expanded">
    <controls:WidgetCard DataContext="{Binding ViewModel}" Header="{loc:T audio.mixer.name}" Icon="{DynamicResource icon.volume}"
                         Accent="{DynamicResource MediaAccentBrush}" AutomationProperties.Name="{Binding AccessibleSummary}">
      <StackPanel>
        <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="0,0,0,8" AutomationProperties.Name="{Binding Name}">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <controls:IconButton Icon="{DynamicResource icon.minus}" Label="{loc:T audio.mixer.quieter}" Command="{Binding Down}" />
                    <controls:IconButton Icon="{DynamicResource icon.plus}" Label="{loc:T audio.mixer.louder}" Command="{Binding Up}" />
                    <controls:IconButton Icon="{DynamicResource icon.volumeMute}" Label="{Binding MuteLabel}" Command="{Binding Mute}" />
                  </StackPanel>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Value}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" />
                  </StackPanel>
                </DockPanel>
                <controls:ProgressPill Value="{Binding Percent, Mode=OneWay}" Maximum="100" Accent="{DynamicResource MediaAccentBrush}"
                                       Margin="0,4,0,0" AutomationProperties.Name="{Binding Name}" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="{loc:T audio.mixer.none}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                   Visibility="{Binding HasNone, Converter={StaticResource audio-mixer.visible}}" />
      </StackPanel>
    </controls:WidgetCard>
  </DataTemplate>

  <DataTemplate x:Key="audio-mixer.Panel">
    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource audio-mixer.Expanded}"
                      AutomationProperties.Name="{Binding ViewModel.AccessibleSummary}" />
  </DataTemplate>

</ResourceDictionary>
