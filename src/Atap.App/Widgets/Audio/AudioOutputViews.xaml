<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Atap.Ui.Controls"
                    xmlns:loc="clr-namespace:Atap.Ui.Localization">

  <!-- Templates get a PlacementViewModel. The widget view model is in .ViewModel.
       Shared by the output and mixer widgets. Nothing in it animates. -->

  <BooleanToVisibilityConverter x:Key="audio-output.visible" />

  <!-- An output: click to make it the default. The current one is marked. -->
  <Style x:Key="audio-output.row" TargetType="Button">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{DynamicResource focus.round}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Chrome" CornerRadius="6" Padding="8,6" Background="Transparent">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource RaisedBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <DataTemplate x:Key="audio-output.Expanded">
    <controls:WidgetCard DataContext="{Binding ViewModel}" Header="{loc:T audio.output.name}" Icon="{DynamicResource icon.volume}"
                         Accent="{DynamicResource MediaAccentBrush}" AutomationProperties.Name="{Binding AccessibleSummary}">
      <StackPanel>
        <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <!-- The full name is the tooltip and the screen reader name, as long names are cut short here. -->
              <Button Style="{StaticResource audio-output.row}" Command="{Binding Pick}" ToolTip="{Binding Name}" AutomationProperties.Name="{Binding Name}">
                <DockPanel>
                  <controls:StrokeIcon x:Name="Check" DockPanel.Dock="Right" Data="{DynamicResource icon.check}" Width="14" Height="14" Margin="6,0,0,0"
                                       Foreground="{DynamicResource MediaAccentBrush}" Visibility="Collapsed" />
                  <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
                </DockPanel>
              </Button>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsDefault}" Value="True">
                  <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="{loc:T audio.output.none}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                   Visibility="{Binding HasNone, Converter={StaticResource audio-output.visible}}" />
        <TextBlock Text="{loc:T audio.output.failed}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                   Visibility="{Binding Failed, Converter={StaticResource audio-output.visible}}" />
      </StackPanel>
    </controls:WidgetCard>
  </DataTemplate>

  <DataTemplate x:Key="audio-output.Panel">
    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource audio-output.Expanded}"
                      AutomationProperties.Name="{Binding ViewModel.AccessibleSummary}" />
  </DataTemplate>

</ResourceDictionary>
