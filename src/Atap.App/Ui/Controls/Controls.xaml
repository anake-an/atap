<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Atap.Ui.Controls"
                    xmlns:custom="clr-namespace:Atap.Core.Custom;assembly=Atap.Core">

  <!-- The UI kit for widget views: focus rings, IconButton, ProgressPill, StatusDot, WidgetCard and card text.
       Merged through Ui/Theme/Cards.xaml. Theme keys use DynamicResource: this file is parsed on its own, and high
       contrast swaps brushes at runtime. In high contrast every control also switches to system colours itself.
       Nothing here animates, so the notch stays idle. Sizes are in plain pixels, the text scale is a LayoutTransform. -->

  <controls:PillRadiusConverter x:Key="controls.PillRadius" />

  <!-- Keyboard focus rings. WPF shows them only when focus came from the keyboard, never after a click. -->
  <!-- For buttons, chips, switches and rows. They are 6 pixel rounded rectangles, so the ring is one too. -->
  <Style x:Key="focus.round">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Border x:Name="Ring" Margin="-3" BorderThickness="2" CornerRadius="8" BorderBrush="{DynamicResource TextBrush}" SnapsToDevicePixels="True" />
          <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding IsHigh, Source={x:Static controls:Contrast.Current}}" Value="True">
              <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
            </DataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- CardCornerRadius plus the 3 pixel gap, so the ring follows the card's corners. -->
  <Style x:Key="focus.card">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Border x:Name="Ring" Margin="-3" BorderThickness="2" CornerRadius="19" BorderBrush="{DynamicResource TextBrush}" SnapsToDevicePixels="True" />
          <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding IsHigh, Source={x:Static controls:Contrast.Current}}" Value="True">
              <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
            </DataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="focus.default">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Border x:Name="Ring" Margin="-2" BorderThickness="2" CornerRadius="4" BorderBrush="{DynamicResource TextBrush}" SnapsToDevicePixels="True" />
          <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding IsHigh, Source={x:Static controls:Contrast.Current}}" Value="True">
              <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
            </DataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- IconButton: 32 by 32, a 6 pixel rounded square, a 16 pixel icon. Hover and press change the background only. -->
  <Style TargetType="controls:IconButton">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Focusable" Value="True" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource focus.round}" />
    <Setter Property="ToolTip" Value="{Binding Label, RelativeSource={RelativeSource Self}}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="controls:IconButton">
          <Border x:Name="Chrome"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="6"
                  SnapsToDevicePixels="True">
            <controls:StrokeIcon x:Name="Glyph"
                                 Data="{TemplateBinding Icon}"
                                 Width="{TemplateBinding IconSize}"
                                 Height="{TemplateBinding IconSize}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource RaisedBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource DividerBrush}" />
              <Setter TargetName="Glyph" Property="Opacity" Value="0.75" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Glyph" Property="Opacity" Value="0.4" />
            </Trigger>
            <!-- High contrast: button colours with a visible edge, highlight on hover, grey text when off. -->
            <DataTrigger Binding="{Binding IsHigh, Source={x:Static controls:Contrast.Current}}" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" />
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
              <Setter TargetName="Chrome" Property="BorderThickness" Value="1" />
              <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
            </DataTrigger>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Binding="{Binding IsHigh, Source={x:Static controls:Contrast.Current}}" Value="True" />
                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
              </MultiDataTrigger.Conditions>
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
              <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
            </MultiDataTrigger>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Binding="{Binding IsHigh, Source={x:Static controls:Contrast.Current}}" Value="True" />
                <Condition Binding="{Binding IsEnabled, RelativeSource={RelativeSource Self}}" Value="False" />
              </MultiDataTrigger.Conditions>
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
              <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
              <Setter TargetName="Glyph" Property="Opacity" Value="1" />
            </MultiDataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Notch.Button: a button with words on the dark notch, such as Add, Save or Join. A 6 pixel rounded rectangle.
       Widgets base their own buttons on it and change only what differs, such as the colours or the padding.
       Notch.AccentButton is the filled one for the main action. -->
  <Style x:Key="Notch.Button" TargetType="Button">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource focus.round}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="12,5" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Chrome"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="6"
                  Padding="{TemplateBinding Padding}"
                  SnapsToDevicePixels="True">
            <ContentPresenter x:Name="Body"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              RecognizesAccessKey="False" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="Opacity" Value="0.85" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Chrome" Property="Opacity" Value="0.4" />
            </Trigger>
            <!-- High contrast: button colours with a visible edge, highlight on hover. -->
            <DataTrigger Binding="{Binding IsHigh, Source={x:Static controls:Contrast.Current}}" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" />
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
              <Setter TargetName="Chrome" Property="BorderThickness" Value="1" />
              <Setter TargetName="Body" Property="TextElement.Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
            </DataTrigger>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Binding="{Binding IsHigh, Source={x:Static controls:Contrast.Current}}" Value="True" />
                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
              </MultiDataTrigger.Conditions>
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
              <Setter TargetName="Body" Property="TextElement.Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
            </MultiDataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Notch.AccentButton" TargetType="Button" BasedOn="{StaticResource Notch.Button}">
    <Setter Property="Background" Value="{DynamicResource ProductivityAccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource NotchSurfaceBrush}" />
  </Style>

  <!-- ProgressPill: a 6 pixel bar with round ends. ProgressBar sizes PART_Indicator from PART_Track. -->
  <Style TargetType="controls:ProgressPill">
    <Setter Property="Height" Value="6" />
    <Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="Accent" Value="{DynamicResource TextBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource focus.default}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="controls:ProgressPill">
          <Grid x:Name="Root" SnapsToDevicePixels="True">
            <Border x:Name="PART_Track"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{Binding ActualHeight, ElementName=Root, Converter={StaticResource controls.PillRadius}}" />
            <Border x:Name="PART_Indicator"
                    HorizontalAlignment="Left"
                    Background="{TemplateBinding Accent}"
                    CornerRadius="{Binding ActualHeight, ElementName=Root, Converter={StaticResource controls.PillRadius}}" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="Level" Value="{x:Static custom:ValueLevel.Unknown}">
              <Setter TargetName="PART_Indicator" Property="Background" Value="{DynamicResource TextMutedBrush}" />
            </Trigger>
            <Trigger Property="Level" Value="{x:Static custom:ValueLevel.Warning}">
              <Setter TargetName="PART_Indicator" Property="Background" Value="{DynamicResource ProductivityAccentBrush}" />
            </Trigger>
            <Trigger Property="Level" Value="{x:Static custom:ValueLevel.Critical}">
              <Setter TargetName="PART_Indicator" Property="Background" Value="{DynamicResource SystemAccentBrush}" />
            </Trigger>
            <!-- A full, dim bar. A moving one would keep the notch awake. -->
            <Trigger Property="IsIndeterminate" Value="True">
              <Setter TargetName="PART_Indicator" Property="Opacity" Value="0.4" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Root" Property="Opacity" Value="0.4" />
            </Trigger>
            <DataTrigger Binding="{Binding IsHigh, Source={x:Static controls:Contrast.Current}}" Value="True">
              <Setter TargetName="PART_Track" Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
              <Setter TargetName="PART_Track" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
              <Setter TargetName="PART_Track" Property="BorderThickness" Value="1" />
              <Setter TargetName="PART_Indicator" Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
            </DataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- StatusDot: 8 pixels. In high contrast the levels also differ in shape. -->
  <Style TargetType="controls:StatusDot">
    <Setter Property="Width" Value="8" />
    <Setter Property="Height" Value="8" />
    <Setter Property="Accent" Value="{DynamicResource MediaAccentBrush}" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource focus.round}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="controls:StatusDot">
          <Grid SnapsToDevicePixels="True">
            <Ellipse x:Name="Dot" Fill="{TemplateBinding Accent}" StrokeThickness="0" />
            <Path x:Name="Shape"
                  Visibility="Collapsed"
                  Stretch="Uniform"
                  Data="M4,0 A4,4 0 1 1 4,8 A4,4 0 1 1 4,0 Z"
                  Fill="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="Level" Value="{x:Static custom:ValueLevel.Unknown}">
              <Setter TargetName="Dot" Property="Fill" Value="Transparent" />
              <Setter TargetName="Dot" Property="Stroke" Value="{DynamicResource TextMutedBrush}" />
              <Setter TargetName="Dot" Property="StrokeThickness" Value="1.5" />
            </Trigger>
            <Trigger Property="Level" Value="{x:Static custom:ValueLevel.Warning}">
              <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource ProductivityAccentBrush}" />
            </Trigger>
            <Trigger Property="Level" Value="{x:Static custom:ValueLevel.Critical}">
              <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource SystemAccentBrush}" />
            </Trigger>
            <!-- High contrast: a circle for Normal, a triangle for Warning, a square for Critical and a ring for Unknown. -->
            <DataTrigger Binding="{Binding IsHigh, Source={x:Static controls:Contrast.Current}}" Value="True">
              <Setter TargetName="Dot" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="Shape" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Binding="{Binding IsHigh, Source={x:Static controls:Contrast.Current}}" Value="True" />
                <Condition Binding="{Binding Level, RelativeSource={RelativeSource Self}}" Value="{x:Static custom:ValueLevel.Warning}" />
              </MultiDataTrigger.Conditions>
              <Setter TargetName="Shape" Property="Data" Value="M4,0 L8,8 L0,8 Z" />
            </MultiDataTrigger>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Binding="{Binding IsHigh, Source={x:Static controls:Contrast.Current}}" Value="True" />
                <Condition Binding="{Binding Level, RelativeSource={RelativeSource Self}}" Value="{x:Static custom:ValueLevel.Critical}" />
              </MultiDataTrigger.Conditions>
              <Setter TargetName="Shape" Property="Data" Value="M0,0 H8 V8 H0 Z" />
            </MultiDataTrigger>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Binding="{Binding IsHigh, Source={x:Static controls:Contrast.Current}}" Value="True" />
                <Condition Binding="{Binding Level, RelativeSource={RelativeSource Self}}" Value="{x:Static custom:ValueLevel.Unknown}" />
              </MultiDataTrigger.Conditions>
              <Setter TargetName="Shape" Property="Fill" Value="Transparent" />
              <Setter TargetName="Shape" Property="Stroke" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
              <Setter TargetName="Shape" Property="StrokeThickness" Value="1.5" />
            </MultiDataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- WidgetCard: the card surface for Expanded and Panel widgets. The header row shows only with a Header. -->
  <Style TargetType="controls:WidgetCard">
    <Setter Property="Background" Value="{DynamicResource CardBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="Accent" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="12" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="Focusable" Value="True" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource focus.card}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="controls:WidgetCard">
          <Border x:Name="Chrome"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{DynamicResource CardCornerRadius}"
                  Padding="{TemplateBinding Padding}"
                  SnapsToDevicePixels="True">
            <DockPanel>
              <StackPanel x:Name="HeaderRow" DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                <controls:StrokeIcon x:Name="HeaderIcon"
                                     Data="{TemplateBinding Icon}"
                                     Foreground="{TemplateBinding Accent}"
                                     Width="14"
                                     Height="14"
                                     Margin="0,0,6,0"
                                     VerticalAlignment="Center" />
                <ContentPresenter x:Name="HeaderText"
                                  ContentSource="Header"
                                  VerticalAlignment="Center"
                                  RecognizesAccessKey="False"
                                  TextElement.FontSize="12"
                                  TextElement.FontWeight="SemiBold"
                                  TextElement.Foreground="{DynamicResource TextSecondaryBrush}" />
              </StackPanel>
              <ContentPresenter x:Name="Body"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
            </DockPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="HasHeader" Value="False">
              <Setter TargetName="HeaderRow" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Icon" Value="{x:Null}">
              <Setter TargetName="HeaderIcon" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="HasCommand" Value="True" />
                <Condition Property="IsMouseOver" Value="True" />
              </MultiTrigger.Conditions>
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource RaisedBrush}" />
            </MultiTrigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Chrome" Property="Opacity" Value="0.5" />
            </Trigger>
            <DataTrigger Binding="{Binding IsHigh, Source={x:Static controls:Contrast.Current}}" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
              <Setter TargetName="Chrome" Property="BorderThickness" Value="1" />
              <Setter TargetName="Chrome" Property="TextElement.Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
              <Setter TargetName="HeaderIcon" Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
              <Setter TargetName="HeaderText" Property="TextElement.Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
            </DataTrigger>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Binding="{Binding IsHigh, Source={x:Static controls:Contrast.Current}}" Value="True" />
                <Condition Binding="{Binding HasCommand, RelativeSource={RelativeSource Self}}" Value="True" />
                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
              </MultiDataTrigger.Conditions>
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
              <Setter TargetName="Chrome" Property="BorderThickness" Value="2" />
            </MultiDataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Text inside cards. Use as Style="{DynamicResource card.Title}". Each switches to the system text colour in high contrast. -->
  <Style x:Key="card.Text" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsHigh, Source={x:Static controls:Contrast.Current}}" Value="True">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- The widget's main line, such as a song title or the next prayer. -->
  <Style x:Key="card.Title" TargetType="TextBlock" BasedOn="{StaticResource card.Text}">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- A big number or time, such as "16:13" or "72%". -->
  <Style x:Key="card.Value" TargetType="TextBlock" BasedOn="{StaticResource card.Text}">
    <Setter Property="FontSize" Value="24" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- Running text that may wrap. -->
  <Style x:Key="card.Body" TargetType="TextBlock" BasedOn="{StaticResource card.Text}">
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="TextTrimming" Value="None" />
  </Style>

  <!-- A small second line, such as an artist, "in 23 minutes" or "Paused". -->
  <Style x:Key="card.Caption" TargetType="TextBlock" BasedOn="{StaticResource card.Text}">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="FontSize" Value="11" />
  </Style>

  <!-- What a widget says when it has nothing to show, such as "No alarms yet." The same look in every widget. -->
  <Style x:Key="card.Empty" TargetType="TextBlock" BasedOn="{StaticResource card.Text}">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="TextTrimming" Value="None" />
  </Style>

</ResourceDictionary>
