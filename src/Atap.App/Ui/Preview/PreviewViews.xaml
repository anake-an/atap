<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Atap.Ui.Controls"
                    xmlns:preview="clr-namespace:Atap.Ui.Preview">

  <!-- Widget previews with sample content, for the layout editor and the Settings summary. Merged by the windows
       that show them, only while they are open. Nothing here ticks or animates. -->
  <BooleanToVisibilityConverter x:Key="Preview.BoolToVisibility" />

  <!-- One widget as it looks on the notch. A widget with no sample content is a plain card with its icon and name. -->
  <DataTemplate DataType="{x:Type preview:PreviewTile}">
    <Grid Width="{Binding Width}" Height="{Binding Height}" AutomationProperties.Name="{Binding AutomationName}">
      <Border x:Name="Card" CornerRadius="14" Background="{DynamicResource CardBrush}" BorderThickness="2" BorderBrush="Transparent"
              Padding="12,8">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <DockPanel>
            <controls:StrokeIcon x:Name="Icon" DockPanel.Dock="Left" Data="{Binding Icon}" Width="16" Height="16" Margin="0,0,8,0"
                                 VerticalAlignment="Center" Foreground="{DynamicResource CustomAccentBrush}" />
            <TextBlock x:Name="Value" Text="{Binding Value}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
          </DockPanel>
          <TextBlock Grid.Row="1" Text="{Binding Detail}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0"
                     TextTrimming="CharacterEllipsis"
                     Visibility="{Binding HasDetail, Converter={StaticResource Preview.BoolToVisibility}}" />
          <Grid Grid.Row="3" Height="4" Visibility="{Binding HasProgress, Converter={StaticResource Preview.BoolToVisibility}}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="{Binding ProgressDone}" />
              <ColumnDefinition Width="{Binding ProgressLeft}" />
            </Grid.ColumnDefinitions>
            <Border Grid.ColumnSpan="2" CornerRadius="2" Background="{DynamicResource RaisedBrush}" />
            <Border x:Name="Bar" CornerRadius="2" Background="{DynamicResource CustomAccentBrush}" />
          </Grid>
        </Grid>
      </Border>
      <!-- Where a dragged widget will land. -->
      <Rectangle x:Name="Marker" RadiusX="14" RadiusY="14" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2"
                 StrokeDashArray="3 2" Visibility="Collapsed" />
    </Grid>
    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding IsPlain}" Value="True">
        <Setter TargetName="Value" Property="Text" Value="{Binding Name}" />
        <Setter TargetName="Value" Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Group}" Value="Media">
        <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource MediaAccentBrush}" />
        <Setter TargetName="Bar" Property="Background" Value="{DynamicResource MediaAccentBrush}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Group}" Value="Productivity">
        <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource ProductivityAccentBrush}" />
        <Setter TargetName="Bar" Property="Background" Value="{DynamicResource ProductivityAccentBrush}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Group}" Value="System">
        <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource SystemAccentBrush}" />
        <Setter TargetName="Bar" Property="Background" Value="{DynamicResource SystemAccentBrush}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Group}" Value="Malaysia">
        <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource MalaysiaAccentBrush}" />
        <Setter TargetName="Bar" Property="Background" Value="{DynamicResource MalaysiaAccentBrush}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding IsSelected}" Value="True">
        <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding IsMarker}" Value="True">
        <Setter TargetName="Card" Property="Opacity" Value="0.55" />
        <Setter TargetName="Marker" Property="Visibility" Value="Visible" />
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>

  <!-- Tiles side by side in the small notch, and on the notch's own 4-column grid when it opens. -->
  <Style x:Key="Preview.RowItem" TargetType="ContentPresenter">
    <Setter Property="Margin" Value="4,0" />
  </Style>
  <Style x:Key="Preview.GridItem" TargetType="ContentPresenter">
    <Setter Property="controls:WidgetGrid.Size" Value="{Binding Size}" />
  </Style>
  <Style x:Key="Preview.Tiles" TargetType="ItemsControl">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="ItemContainerStyle" Value="{StaticResource Preview.RowItem}" />
    <Setter Property="ItemsPanel">
      <Setter.Value>
        <ItemsPanelTemplate>
          <StackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsGrid}" Value="True">
        <Setter Property="ItemContainerStyle" Value="{StaticResource Preview.GridItem}" />
        <Setter Property="ItemsPanel">
          <Setter.Value>
            <ItemsPanelTemplate>
              <controls:WidgetGrid />
            </ItemsPanelTemplate>
          </Setter.Value>
        </Setter>
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- One state of the notch as a picture, for the Settings summary. -->
  <DataTemplate DataType="{x:Type preview:NotchPicture}">
    <Border Background="{DynamicResource NotchSurfaceBrush}" CornerRadius="0,0,26,26" Padding="10,10,10,14" MinWidth="220" MinHeight="56"
            HorizontalAlignment="Center" VerticalAlignment="Top" AutomationProperties.Name="{Binding AutomationName}">
      <Grid>
        <ItemsControl ItemsSource="{Binding Tiles}" Style="{StaticResource Preview.Tiles}" HorizontalAlignment="Center" />
        <TextBlock Text="{Binding EmptyText}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Visibility="{Binding IsEmpty, Converter={StaticResource Preview.BoolToVisibility}}" />
      </Grid>
    </Border>
  </DataTemplate>

</ResourceDictionary>
