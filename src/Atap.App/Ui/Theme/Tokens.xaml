<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=System.Runtime">

  <!-- Design tokens from the product spec. Use these keys, never raw colours, in new XAML. -->

  <!-- Notch (dark) surfaces. -->
  <Color x:Key="NotchSurfaceColor">#FF000000</Color>
  <Color x:Key="CardColor">#FF161616</Color>
  <Color x:Key="RaisedColor">#FF232323</Color>
  <Color x:Key="DividerColor">#FF262626</Color>
  <Color x:Key="TextColor">#FFFAFAF9</Color>
  <Color x:Key="TextSecondaryColor">#FFA8A29E</Color>
  <Color x:Key="TextMutedColor">#FF8A8580</Color>

  <SolidColorBrush x:Key="NotchSurfaceBrush" Color="{StaticResource NotchSurfaceColor}" />
  <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}" />
  <SolidColorBrush x:Key="RaisedBrush" Color="{StaticResource RaisedColor}" />
  <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource DividerColor}" />
  <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
  <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />

  <!-- Group accents on dark, one per WidgetGroup. -->
  <Color x:Key="MediaAccentColor">#FF2DD4BF</Color>
  <Color x:Key="ProductivityAccentColor">#FFFBBF24</Color>
  <Color x:Key="SystemAccentColor">#FFFB7185</Color>
  <Color x:Key="CustomAccentColor">#FF60A5FA</Color>
  <Color x:Key="MalaysiaAccentColor">#FFA78BFA</Color>

  <SolidColorBrush x:Key="MediaAccentBrush" Color="{StaticResource MediaAccentColor}" />
  <SolidColorBrush x:Key="ProductivityAccentBrush" Color="{StaticResource ProductivityAccentColor}" />
  <SolidColorBrush x:Key="SystemAccentBrush" Color="{StaticResource SystemAccentColor}" />
  <SolidColorBrush x:Key="CustomAccentBrush" Color="{StaticResource CustomAccentColor}" />
  <SolidColorBrush x:Key="MalaysiaAccentBrush" Color="{StaticResource MalaysiaAccentColor}" />

  <!-- Light surfaces: settings window and onboarding. -->
  <Color x:Key="WindowColor">#FFF3F3F3</Color>
  <Color x:Key="SettingsCardColor">#FFFFFFFF</Color>
  <Color x:Key="SettingsCardBorderColor">#FFE5E5E5</Color>
  <Color x:Key="SettingsNavSelectedColor">#FFE9E9E9</Color>
  <Color x:Key="InkColor">#FF0C0A09</Color>
  <Color x:Key="InkSecondaryColor">#FF57534E</Color>
  <Color x:Key="InkMutedColor">#FF6B6560</Color>
  <Color x:Key="ToggleOnColor">#FF0F766E</Color>

  <SolidColorBrush x:Key="WindowBrush" Color="{StaticResource WindowColor}" />
  <SolidColorBrush x:Key="SettingsCardBrush" Color="{StaticResource SettingsCardColor}" />
  <SolidColorBrush x:Key="SettingsCardBorderBrush" Color="{StaticResource SettingsCardBorderColor}" />
  <SolidColorBrush x:Key="SettingsNavSelectedBrush" Color="{StaticResource SettingsNavSelectedColor}" />
  <SolidColorBrush x:Key="InkBrush" Color="{StaticResource InkColor}" />
  <SolidColorBrush x:Key="InkSecondaryBrush" Color="{StaticResource InkSecondaryColor}" />
  <SolidColorBrush x:Key="InkMutedBrush" Color="{StaticResource InkMutedColor}" />
  <SolidColorBrush x:Key="ToggleOnBrush" Color="{StaticResource ToggleOnColor}" />

  <!-- Group accents and tints on light. -->
  <SolidColorBrush x:Key="MediaAccentLightBrush" Color="#FF0F766E" />
  <SolidColorBrush x:Key="ProductivityAccentLightBrush" Color="#FFB45309" />
  <SolidColorBrush x:Key="SystemAccentLightBrush" Color="#FFBE123C" />
  <SolidColorBrush x:Key="CustomAccentLightBrush" Color="#FF1D4ED8" />
  <SolidColorBrush x:Key="MalaysiaAccentLightBrush" Color="#FF6D28D9" />
  <SolidColorBrush x:Key="MediaTintBrush" Color="#FFCCFBF1" />
  <SolidColorBrush x:Key="ProductivityTintBrush" Color="#FFFEF3C7" />
  <SolidColorBrush x:Key="SystemTintBrush" Color="#FFFFE4E6" />
  <SolidColorBrush x:Key="CustomTintBrush" Color="#FFDBEAFE" />
  <SolidColorBrush x:Key="MalaysiaTintBrush" Color="#FFEDE9FE" />

  <!-- Shape. The notch radii follow the spec per surface. -->
  <CornerRadius x:Key="CardCornerRadius">16</CornerRadius>
  <CornerRadius x:Key="SettingsCardCornerRadius">8</CornerRadius>
  <system:Double x:Key="GridGap">8</system:Double>
  <system:Double x:Key="SurfacePadding">14</system:Double>

</ResourceDictionary>
