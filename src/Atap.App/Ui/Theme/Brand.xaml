<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    mc:Ignorable="po">

  <!-- The Atap logo. tools/brand/generate.cs writes this file from assets/brand/atap-icon.svg, so do not edit it by hand.
       Shapes rather than an icon image, so it stays sharp at any size and display scale. It keeps its own colours
       in every theme and in high contrast, like the icon on the taskbar. -->
  <DrawingImage x:Key="Brand.Logo" po:Freeze="True">
    <DrawingImage.Drawing>
      <DrawingGroup>
        <GeometryDrawing Brush="#0C0A09">
          <GeometryDrawing.Geometry>
            <RectangleGeometry Rect="0,0,120,120" RadiusX="28" RadiusY="28" />
          </GeometryDrawing.Geometry>
        </GeometryDrawing>
        <GeometryDrawing Brush="#FAFAF9" Geometry="M28 22H92A10 10 0 0 1 102 32V38A10 10 0 0 1 92 48H71L79 70H41L49 48H28A10 10 0 0 1 18 38V32A10 10 0 0 1 28 22Z" />
        <GeometryDrawing Brush="#2DD4BF" Geometry="M28 56H38L30 78H90L82 56H92A10 10 0 0 1 102 66V88A10 10 0 0 1 92 98H28A10 10 0 0 1 18 88V66A10 10 0 0 1 28 56Z" />
      </DrawingGroup>
    </DrawingImage.Drawing>
  </DrawingImage>

</ResourceDictionary>
