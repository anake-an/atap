<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Atap.Ui.Controls">

  <!-- The light Windows 11 look for the settings window, hand-made from the tokens in Tokens.xaml.
       Merged only while the settings window is open, through Settings/Form/SettingsForm.xaml. -->

  <BooleanToVisibilityConverter x:Key="Settings.BoolToVisibility" />

  <!-- Keyboard focus only, never on a mouse click. -->
  <Style x:Key="Settings.FocusVisual">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Rectangle Margin="-3" RadiusX="6" RadiusY="6" Stroke="{DynamicResource InkBrush}" StrokeThickness="2" SnapsToDevicePixels="True" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Text -->
  <Style x:Key="Settings.PageTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="28" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="Settings.PageHint" TargetType="TextBlock">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource InkSecondaryBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Margin" Value="0,4,0,20" />
  </Style>

  <Style x:Key="Settings.SectionTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Margin" Value="0,16,0,8" />
  </Style>

  <Style x:Key="Settings.Label" TargetType="TextBlock">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="Settings.Hint" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource InkSecondaryBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Margin" Value="0,2,0,0" />
  </Style>

  <Style x:Key="Settings.Error" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource SystemAccentLightBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Margin" Value="0,4,0,0" />
    <Setter Property="AutomationProperties.LiveSetting" Value="Assertive" />
  </Style>

  <!-- A white rounded card. Every setting row and every hand-made card sits in one. -->
  <Style x:Key="Settings.Card" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource SettingsCardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SettingsCardBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource SettingsCardCornerRadius}" />
    <Setter Property="Padding" Value="16,12" />
    <Setter Property="Margin" Value="0,0,0,4" />
  </Style>

  <!-- Toggle switch: a CheckBox with a track and a knob. -->
  <Style x:Key="Settings.Toggle" TargetType="CheckBox">
    <Setter Property="FocusVisualStyle" Value="{StaticResource Settings.FocusVisual}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Border x:Name="Track" Width="40" Height="20" CornerRadius="10" BorderThickness="1"
                  BorderBrush="{DynamicResource InkSecondaryBrush}" Background="{DynamicResource SettingsCardBrush}">
            <Ellipse x:Name="Knob" Width="12" Height="12" Margin="4,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                     Fill="{DynamicResource InkSecondaryBrush}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Track" Property="Background" Value="{DynamicResource ToggleOnBrush}" />
              <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource ToggleOnBrush}" />
              <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource SettingsCardBrush}" />
              <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Buttons -->
  <Style x:Key="Settings.Button" TargetType="Button">
    <Setter Property="FocusVisualStyle" Value="{StaticResource Settings.FocusVisual}" />
    <Setter Property="Background" Value="{DynamicResource SettingsCardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SettingsCardBorderBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="12,5" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="MinWidth" Value="80" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SettingsNavSelectedBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource WindowBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Settings.AccentButton" TargetType="Button" BasedOn="{StaticResource Settings.Button}">
    <Setter Property="Background" Value="{DynamicResource ToggleOnBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ToggleOnBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource SettingsCardBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="Opacity" Value="0.9" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Chrome" Property="Opacity" Value="0.8" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Inputs keep the Windows look, with the spacing and colours of the cards. -->
  <!-- Text fields: rounded, with a thin line along the bottom that turns into a thicker accent line while typing,
       as in Windows 11. The password field below shares the look. -->
  <Style x:Key="Settings.TextBox" TargetType="TextBox">
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
    <Setter Property="Background" Value="{DynamicResource SettingsCardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SettingsCardBorderBrush}" />
    <Setter Property="CaretBrush" Value="{DynamicResource InkBrush}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource ToggleOnBrush}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="Chrome" CornerRadius="4" BorderThickness="1" SnapsToDevicePixels="True"
                  Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}">
            <Grid>
              <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
              <Border x:Name="Underline" Height="1" VerticalAlignment="Bottom" CornerRadius="0,0,4,4"
                      Background="{DynamicResource InkMutedBrush}" Opacity="0.6" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource WindowBrush}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SettingsCardBrush}" />
              <Setter TargetName="Underline" Property="Height" Value="2" />
              <Setter TargetName="Underline" Property="Opacity" Value="1" />
              <Setter TargetName="Underline" Property="Background" Value="{DynamicResource ToggleOnBrush}" />
            </Trigger>
            <Trigger Property="IsReadOnly" Value="True">
              <Setter TargetName="Underline" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Settings.PasswordBox" TargetType="PasswordBox">
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
    <Setter Property="Background" Value="{DynamicResource SettingsCardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SettingsCardBorderBrush}" />
    <Setter Property="CaretBrush" Value="{DynamicResource InkBrush}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource ToggleOnBrush}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="PasswordBox">
          <Border x:Name="Chrome" CornerRadius="4" BorderThickness="1" SnapsToDevicePixels="True"
                  Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}">
            <Grid>
              <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
              <Border x:Name="Underline" Height="1" VerticalAlignment="Bottom" CornerRadius="0,0,4,4"
                      Background="{DynamicResource InkMutedBrush}" Opacity="0.6" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource WindowBrush}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SettingsCardBrush}" />
              <Setter TargetName="Underline" Property="Height" Value="2" />
              <Setter TargetName="Underline" Property="Opacity" Value="1" />
              <Setter TargetName="Underline" Property="Background" Value="{DynamicResource ToggleOnBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Dropdowns: a rounded field with a chevron, and a rounded list with a shadow. The chosen item has an accent
       bar, as in Windows 11. The list fades in only when Windows' own animation settings allow it. -->
  <Style x:Key="Settings.ComboBoxItem" TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Grid>
            <Border x:Name="Chrome" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center" />
            </Border>
            <Border x:Name="Marker" Width="3" Height="16" CornerRadius="1.5" HorizontalAlignment="Left" VerticalAlignment="Center"
                    Background="{DynamicResource ToggleOnBrush}" Visibility="Collapsed" />
            <!-- In high contrast the hover fill is plain, so the item under the arrow keys gets an outline instead. -->
            <Border x:Name="Outline" CornerRadius="4" BorderThickness="2" BorderBrush="{DynamicResource InkBrush}" Visibility="Collapsed" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource WindowBrush}" />
            </Trigger>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Binding="{Binding IsHighlighted, RelativeSource={RelativeSource Self}}" Value="True" />
                <Condition Binding="{Binding IsHigh, Source={x:Static controls:Contrast.Current}}" Value="True" />
              </MultiDataTrigger.Conditions>
              <Setter TargetName="Outline" Property="Visibility" Value="Visible" />
            </MultiDataTrigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SettingsNavSelectedBrush}" />
              <Setter TargetName="Marker" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Settings.ComboBox" TargetType="ComboBox">
    <Setter Property="FocusVisualStyle" Value="{StaticResource Settings.FocusVisual}" />
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
    <Setter Property="Background" Value="{DynamicResource SettingsCardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SettingsCardBorderBrush}" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="MinWidth" Value="180" />
    <Setter Property="Padding" Value="12,5,36,5" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="MaxDropDownHeight" Value="320" />
    <Setter Property="ItemContainerStyle" Value="{StaticResource Settings.ComboBoxItem}" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid SnapsToDevicePixels="True">
            <!-- The whole field opens the list. -->
            <ToggleButton x:Name="Field"
                          Focusable="False"
                          ClickMode="Press"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Border x:Name="Chrome"
                          CornerRadius="4"
                          BorderThickness="1,1,1,1"
                          Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                          BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}">
                    <!-- A slightly darker line along the bottom, as Windows 11 fields have. -->
                    <Border CornerRadius="0,0,4,4" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource InkMutedBrush}" Opacity="0.35" />
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource WindowBrush}" />
                    </Trigger>
                    <Trigger Property="IsChecked" Value="True">
                      <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SettingsNavSelectedBrush}" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>

            <ContentPresenter x:Name="Selection"
                              IsHitTestVisible="False"
                              Margin="{TemplateBinding Padding}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              HorizontalAlignment="Left"
                              Content="{TemplateBinding SelectionBoxItem}"
                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                              TextElement.Foreground="{TemplateBinding Foreground}" />

            <Path x:Name="Chevron"
                  IsHitTestVisible="False"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Center"
                  Margin="0,1,14,0"
                  Data="M0,0 L5,5 L10,0"
                  Stroke="{DynamicResource InkSecondaryBrush}"
                  StrokeThickness="1.3"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  StrokeLineJoin="Round" />

            <Popup x:Name="PART_Popup"
                   AllowsTransparency="True"
                   Placement="Bottom"
                   VerticalOffset="-4"
                   HorizontalOffset="-8"
                   Focusable="False"
                   IsOpen="{TemplateBinding IsDropDownOpen}"
                   PopupAnimation="{DynamicResource {x:Static SystemParameters.ComboBoxPopupAnimationKey}}">
              <!-- The margin is room for the shadow. -->
              <Border Margin="8"
                      MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                      MaxHeight="{TemplateBinding MaxDropDownHeight}"
                      Padding="4"
                      CornerRadius="8"
                      Background="{DynamicResource SettingsCardBrush}"
                      BorderBrush="{DynamicResource SettingsCardBorderBrush}"
                      BorderThickness="1">
                <Border.Effect>
                  <DropShadowEffect BlurRadius="14" ShadowDepth="3" Direction="270" Opacity="0.18" />
                </Border.Effect>
                <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsDropDownOpen" Value="True">
              <Setter TargetName="Chevron" Property="Stroke" Value="{DynamicResource InkBrush}" />
              <Setter TargetName="Chevron" Property="Margin" Value="0,3,14,0" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="Chevron" Property="Stroke" Value="{DynamicResource InkBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Sliders: a thin rounded track, filled with the accent up to a round white knob whose centre dot grows
       on hover, as in Windows 11. -->
  <Style x:Key="Settings.SliderTrackPart" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Border Background="Transparent">
            <Border Height="4" CornerRadius="2" VerticalAlignment="Center" Background="{TemplateBinding Background}" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Settings.SliderThumb" TargetType="Thumb">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="20" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Grid>
            <Ellipse Fill="{DynamicResource SettingsCardBrush}" Stroke="{DynamicResource SettingsCardBorderBrush}" StrokeThickness="1">
              <Ellipse.Effect>
                <DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Opacity="0.2" />
              </Ellipse.Effect>
            </Ellipse>
            <Ellipse x:Name="Dot" Width="10" Height="10" Fill="{DynamicResource ToggleOnBrush}" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Dot" Property="Width" Value="12" />
              <Setter TargetName="Dot" Property="Height" Value="12" />
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
              <Setter TargetName="Dot" Property="Width" Value="8" />
              <Setter TargetName="Dot" Property="Height" Value="8" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Settings.Slider" TargetType="Slider">
    <Setter Property="FocusVisualStyle" Value="{StaticResource Settings.FocusVisual}" />
    <Setter Property="MinWidth" Value="180" />
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="IsMoveToPointEnabled" Value="True" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Slider">
          <Grid Background="Transparent">
            <Track x:Name="PART_Track">
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource Settings.SliderTrackPart}"
                              Background="{DynamicResource ToggleOnBrush}" />
              </Track.DecreaseRepeatButton>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource Settings.SliderTrackPart}"
                              Background="{DynamicResource InkMutedBrush}" Opacity="0.45" />
              </Track.IncreaseRepeatButton>
              <Track.Thumb>
                <Thumb Style="{StaticResource Settings.SliderThumb}" />
              </Track.Thumb>
            </Track>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Scroll bars: a thin rounded bar with no arrows that darkens under the pointer, as in Windows 11. -->
  <Style x:Key="Settings.ScrollPage" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Border Background="Transparent" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Settings.ScrollThumb" TargetType="Thumb">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border x:Name="Bar" Margin="3" CornerRadius="3" Background="{DynamicResource InkMutedBrush}" Opacity="0.45" />
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bar" Property="Opacity" Value="0.75" />
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
              <Setter TargetName="Bar" Property="Opacity" Value="0.9" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ScrollBar">
    <Setter Property="Width" Value="12" />
    <Setter Property="MinWidth" Value="12" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Track x:Name="PART_Track" IsDirectionReversed="True">
            <Track.DecreaseRepeatButton>
              <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource Settings.ScrollPage}" />
            </Track.DecreaseRepeatButton>
            <Track.IncreaseRepeatButton>
              <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource Settings.ScrollPage}" />
            </Track.IncreaseRepeatButton>
            <Track.Thumb>
              <Thumb Style="{StaticResource Settings.ScrollThumb}" />
            </Track.Thumb>
          </Track>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Width" Value="Auto" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Height" Value="12" />
        <Setter Property="MinHeight" Value="12" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ScrollBar">
              <Track x:Name="PART_Track" IsDirectionReversed="False">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource Settings.ScrollPage}" />
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource Settings.ScrollPage}" />
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Style="{StaticResource Settings.ScrollThumb}" />
                </Track.Thumb>
              </Track>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- Segmented control: a ListBox of three choices or fewer, side by side. Arrow keys move the choice. -->
  <Style x:Key="Settings.SegmentItem" TargetType="ListBoxItem">
    <Setter Property="FocusVisualStyle" Value="{StaticResource Settings.FocusVisual}" />
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
    <Setter Property="Padding" Value="14,5" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Chrome" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}" Margin="2">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SettingsNavSelectedBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ToggleOnBrush}" />
              <Setter Property="Foreground" Value="{DynamicResource SettingsCardBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Settings.Segmented" TargetType="ListBox">
    <Setter Property="Background" Value="{DynamicResource WindowBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SettingsCardBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="ItemContainerStyle" Value="{StaticResource Settings.SegmentItem}" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ItemsPanel">
      <Setter.Value>
        <ItemsPanelTemplate>
          <WrapPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBox">
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
            <ItemsPresenter />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Left navigation -->
  <Style x:Key="Settings.NavItem" TargetType="ListBoxItem">
    <Setter Property="FocusVisualStyle" Value="{StaticResource Settings.FocusVisual}" />
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
    <Setter Property="Padding" Value="12,9" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Grid>
            <Border x:Name="Chrome" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center" />
            </Border>
            <Border x:Name="Pill" Width="3" Height="16" CornerRadius="2" HorizontalAlignment="Left" VerticalAlignment="Center"
                    Background="{DynamicResource ToggleOnBrush}" Visibility="Collapsed" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SettingsNavSelectedBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SettingsNavSelectedBrush}" />
              <Setter TargetName="Pill" Property="Visibility" Value="Visible" />
              <Setter Property="FontWeight" Value="SemiBold" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Settings.NavList" TargetType="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="ItemContainerStyle" Value="{StaticResource Settings.NavItem}" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
  </Style>

  <!-- "More options": a header that opens and closes the extra settings below it. -->
  <Style x:Key="Settings.ExpanderHeader" TargetType="ToggleButton">
    <Setter Property="FocusVisualStyle" Value="{StaticResource Settings.FocusVisual}" />
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="Chrome" Background="{DynamicResource SettingsCardBrush}" BorderBrush="{DynamicResource SettingsCardBorderBrush}"
                  BorderThickness="1" CornerRadius="{StaticResource SettingsCardCornerRadius}" Padding="16,12">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="False" />
              <TextBlock x:Name="Chevron" Grid.Column="1" Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="12"
                         VerticalAlignment="Center" Margin="12,0,0,0" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SettingsNavSelectedBrush}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Chevron" Property="Text" Value="&#xE70E;" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The header button is the only tab stop. -->
  <Style x:Key="Settings.Expander" TargetType="Expander">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Margin" Value="0,12,0,0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Expander">
          <StackPanel>
            <ToggleButton Style="{StaticResource Settings.ExpanderHeader}"
                          Content="{TemplateBinding Header}"
                          ContentTemplate="{TemplateBinding HeaderTemplate}"
                          AutomationProperties.Name="{Binding (AutomationProperties.Name), RelativeSource={RelativeSource TemplatedParent}}"
                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
            <ContentPresenter x:Name="Body" Margin="0,4,0,0" Visibility="Collapsed" />
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsExpanded" Value="True">
              <Setter TargetName="Body" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
