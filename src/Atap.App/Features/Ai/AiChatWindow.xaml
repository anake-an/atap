<Window x:Class="Atap.Features.Ai.AiChatWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Atap.Ui.Localization"
        xmlns:ai="clr-namespace:Atap.Features.Ai"
        Title="{loc:T ai.chat.title}"
        Icon="/Atap;component/Assets/atap.ico"
        Width="920" Height="640" MinWidth="560" MinHeight="420"
        WindowStartupLocation="Manual"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource InkBrush}"
        FontFamily="{StaticResource TextFont}"
        FontSize="14"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

  <!-- Made when the chat opens and closed, never hidden. Answers are plain text in read-only boxes. Nothing in
       them is parsed, linked or loaded. -->
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Atap;component/Ui/Theme/Settings.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <!-- A small button under an answer, such as Copy. -->
      <Style x:Key="AiChat.SmallButton" TargetType="Button" BasedOn="{StaticResource Settings.Button}">
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="10,2" />
        <Setter Property="FontSize" Value="12" />
      </Style>

      <!-- One question and its answer: the question on the right in an accent bubble, the answer on the left as
           plain text, then the service and Copy under it. -->
      <DataTemplate x:Key="AiChat.Exchange" DataType="{x:Type ai:AiExchange}">
        <StackPanel Margin="0,0,0,24" AutomationProperties.Name="{Binding QuestionLine}">
          <Border HorizontalAlignment="Right" MaxWidth="520" Padding="14,9" CornerRadius="8"
                  Background="{DynamicResource ToggleOnBrush}">
            <TextBlock Text="{Binding QuestionText}" TextWrapping="Wrap" Foreground="{DynamicResource SettingsCardBrush}"
                       AutomationProperties.Name="{Binding QuestionText}" />
          </Border>
          <TextBox x:Name="Answer" Text="{Binding AnswerText, Mode=OneWay}" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                   TextWrapping="Wrap" AcceptsReturn="True" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled"
                   Margin="-3,14,0,0" Padding="0" BorderThickness="0" Background="Transparent"
                   Foreground="{DynamicResource InkBrush}" SelectionBrush="{DynamicResource ToggleOnBrush}" FontSize="14" FocusVisualStyle="{x:Null}"
                   AutomationProperties.Name="{loc:T ai.answer}"
                   Visibility="{Binding HasAnswer, Converter={StaticResource Settings.BoolToVisibility}}" />
          <TextBlock x:Name="Status" Text="{Binding StatusText}" Style="{StaticResource Settings.Hint}" Margin="0,10,0,0"
                     AutomationProperties.LiveSetting="Polite"
                     Visibility="{Binding HasStatus, Converter={StaticResource Settings.BoolToVisibility}}" />
          <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <TextBlock Text="{Binding ServiceName}" FontSize="12" Foreground="{DynamicResource InkMutedBrush}" VerticalAlignment="Center" />
            <Button Style="{StaticResource AiChat.SmallButton}" Content="{Binding CopyText}" Command="{Binding CopyCommand}" Margin="12,0,0,0"
                    AutomationProperties.Name="{loc:T ai.copy}"
                    Visibility="{Binding HasAnswer, Converter={StaticResource Settings.BoolToVisibility}}" />
          </StackPanel>
        </StackPanel>
        <DataTemplate.Triggers>
          <DataTrigger Binding="{Binding HasFailed}" Value="True">
            <Setter TargetName="Status" Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter TargetName="Status" Property="FontWeight" Value="SemiBold" />
          </DataTrigger>
        </DataTemplate.Triggers>
      </DataTemplate>

      <DataTemplate x:Key="AiChat.Item" DataType="{x:Type ai:AiChat}">
        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" AutomationProperties.Name="{Binding Title}" />
      </DataTemplate>
    </ResourceDictionary>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="248" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- New chat, then every chat, newest first. -->
    <DockPanel Margin="12,16,8,16">
      <Button DockPanel.Dock="Top" Style="{StaticResource Settings.Button}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
              Command="{Binding NewChatCommand}" Margin="0,0,0,12" AutomationProperties.Name="{loc:T ai.chat.new}">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Center" />
          <TextBlock Text="{loc:T ai.chat.new}" Margin="10,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <ListBox x:Name="ChatList" Style="{StaticResource Settings.NavList}"
               ItemsSource="{Binding Chats}" SelectedItem="{Binding SelectedChat}"
               ItemTemplate="{StaticResource AiChat.Item}"
               AutomationProperties.Name="{loc:T ai.chat.list}" />
    </DockPanel>

    <DockPanel Grid.Column="1" Margin="8,16,16,16">
      <!-- The box to type in. Enter sends and Shift+Enter starts a new line. -->
      <Border DockPanel.Dock="Bottom" Padding="12" CornerRadius="8" BorderThickness="1" Margin="0,12,0,0"
              Background="{DynamicResource SettingsCardBrush}" BorderBrush="{DynamicResource SettingsCardBorderBrush}">
        <StackPanel>
          <TextBlock Text="{Binding SetupText}" Style="{StaticResource Settings.Hint}" Margin="2,0,0,8" TextWrapping="Wrap"
                     Visibility="{Binding HasSetupText, Converter={StaticResource Settings.BoolToVisibility}}" />
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="10,0,0,0">
              <Button Style="{StaticResource Settings.Button}" Content="{loc:T ai.stop}" Command="{Binding StopCommand}" Margin="0,0,8,0"
                      Visibility="{Binding SelectedChat.IsAsking, Converter={StaticResource Settings.BoolToVisibility}, FallbackValue=Collapsed}" />
              <Button Style="{StaticResource Settings.AccentButton}" Content="{loc:T ai.chat.send}" Command="{Binding SendCommand}" />
            </StackPanel>
            <Grid>
              <TextBox x:Name="Box" Style="{StaticResource Settings.TextBox}"
                       Text="{Binding Draft, UpdateSourceTrigger=PropertyChanged}"
                       AcceptsReturn="True" TextWrapping="Wrap" MinHeight="36" MaxHeight="160" Padding="8,7"
                       VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"
                       AutomationProperties.Name="{loc:T ai.chat.box}"
                       AutomationProperties.HelpText="{loc:T ai.chat.placeholder}" />
              <TextBlock Text="{loc:T ai.chat.placeholder}" Foreground="{DynamicResource InkMutedBrush}" Margin="11,8,0,0"
                         VerticalAlignment="Top" IsHitTestVisible="False" TextTrimming="CharacterEllipsis">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Draft}" Value="">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </Grid>
          </DockPanel>
        </StackPanel>
      </Border>

      <!-- The chosen chat. A new chat shows a hint instead. -->
      <Grid>
        <ScrollViewer x:Name="Messages" Focusable="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding SelectedChat.Exchanges}" ItemTemplate="{StaticResource AiChat.Exchange}"
                        Focusable="False" IsTabStop="False" MaxWidth="760" Margin="16,8,16,0"
                        AutomationProperties.Name="{loc:T ai.chat.messages}" />
        </ScrollViewer>
        <TextBlock Text="{loc:T ai.chat.empty}" Style="{StaticResource Settings.Hint}" FontSize="14" TextWrapping="Wrap" TextAlignment="Center"
                   MaxWidth="360" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="{Binding IsChatEmpty, Converter={StaticResource Settings.BoolToVisibility}}" />
      </Grid>
    </DockPanel>
  </Grid>
</Window>
