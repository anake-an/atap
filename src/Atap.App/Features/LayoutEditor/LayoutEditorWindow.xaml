<Window x:Class="Atap.Features.LayoutEditor.LayoutEditorWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Atap.Ui.Localization"
        Title="{loc:T layouteditor.title}"
        Icon="/Atap;component/Assets/atap.ico"
        Width="1120" Height="760" MinWidth="760" MinHeight="520"
        WindowStartupLocation="Manual"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource InkBrush}"
        FontFamily="{StaticResource TextFont}"
        FontSize="14"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

  <!-- Created when the editor opens and closed when it is done. Nothing is saved until Done. -->
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Atap;component/Ui/Theme/Settings.xaml" />
        <ResourceDictionary Source="/Atap;component/Ui/Preview/PreviewViews.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <!-- The ring around a tile on the notch picture. Light, so it shows on the black notch. -->
      <Style x:Key="Editor.TileFocus">
        <Setter Property="Control.Template">
          <Setter.Value>
            <ControlTemplate>
              <Rectangle Margin="-3" RadiusX="16" RadiusY="16" Stroke="{DynamicResource TextBrush}" StrokeThickness="2" SnapsToDevicePixels="True" />
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- A tile on the notch picture. Click or Tab selects it, a drag moves it, the keys move or remove it. -->
      <Style x:Key="Editor.TileButton" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Editor.TileFocus}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <ContentPresenter />
            </ControlTemplate>
          </Setter.Value>
        </Setter>
        <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnTileMouseDown" />
        <EventSetter Event="PreviewKeyDown" Handler="OnTileKeyDown" />
        <EventSetter Event="GotKeyboardFocus" Handler="OnTileFocused" />
        <Style.Triggers>
          <DataTrigger Binding="{Binding IsMarker}" Value="True">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsHitTestVisible" Value="False" />
          </DataTrigger>
        </Style.Triggers>
      </Style>

      <DataTemplate x:Key="Editor.PreviewTile">
        <Button Style="{StaticResource Editor.TileButton}" Content="{Binding}"
                Command="{Binding DataContext.SelectTileCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                AutomationProperties.Name="{Binding AutomationName}" AutomationProperties.HelpText="{loc:T layouteditor.tileHelp}" />
      </DataTemplate>

      <!-- A size, as a box as wide as the widget is at that size. -->
      <DataTemplate x:Key="Editor.SizeMark">
        <Border Width="{Binding Width}" Height="14" CornerRadius="6" Margin="0,0,4,0" BorderThickness="1"
                BorderBrush="{DynamicResource InkMutedBrush}" ToolTip="{Binding Name}">
          <TextBlock Text="{Binding Label}" FontSize="9" Foreground="{DynamicResource InkSecondaryBrush}" HorizontalAlignment="Center"
                     VerticalAlignment="Center" />
        </Border>
      </DataTemplate>

      <!-- A widget to add: how it looks on the notch, what it is, and Add. Drag the preview onto the notch. -->
      <DataTemplate x:Key="Editor.GalleryItem">
        <Border Style="{StaticResource Settings.Card}" Padding="10" Margin="0,0,0,8" AutomationProperties.Name="{Binding Name}"
                AutomationProperties.HelpText="{Binding Line}">
          <StackPanel>
            <Border x:Name="Preview" Background="{DynamicResource NotchSurfaceBrush}" CornerRadius="10" Padding="8" Cursor="Hand"
                    PreviewMouseLeftButtonDown="OnGalleryMouseDown" AutomationProperties.Name="{Binding Preview.AutomationName}">
              <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" MaxHeight="64">
                <ContentPresenter Content="{Binding Preview}" />
              </Viewbox>
            </Border>
            <Grid Margin="0,8,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,8,0">
                <TextBlock Text="{Binding Name}" Style="{StaticResource Settings.Label}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Line}" Style="{StaticResource Settings.Hint}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0" AutomationProperties.Name="{Binding SizesText}">
                  <ItemsControl ItemsSource="{Binding Sizes}" ItemTemplate="{StaticResource Editor.SizeMark}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                  </ItemsControl>
                </StackPanel>
                <TextBlock Text="{Binding Note}" Style="{StaticResource Settings.Hint}" FontStyle="Italic" Margin="0,4,0,0"
                           Visibility="{Binding HasNote, Converter={StaticResource Settings.BoolToVisibility}}" />
              </StackPanel>
              <Button Grid.Column="1" Style="{StaticResource Settings.Button}" MinWidth="64" Content="{loc:T layouteditor.add}"
                      AutomationProperties.HelpText="{Binding Name}" Command="{Binding Add}" VerticalAlignment="Top" />
            </Grid>
          </StackPanel>
        </Border>
        <DataTemplate.Triggers>
          <DataTrigger Binding="{Binding CanAdd}" Value="False">
            <Setter TargetName="Preview" Property="Opacity" Value="0.5" />
            <Setter TargetName="Preview" Property="Cursor" Value="Arrow" />
          </DataTrigger>
        </DataTemplate.Triggers>
      </DataTemplate>
    </ResourceDictionary>
  </Window.Resources>

  <Grid>
    <Grid Margin="24,16,24,16">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- Title, the profile being edited, and undo. -->
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Style="{StaticResource Settings.Button}" Content="{loc:T layouteditor.undo}" Command="{Binding UndoCommand}"
                  IsEnabled="{Binding CanUndo}" Margin="0,0,6,0" />
          <Button Style="{StaticResource Settings.Button}" Content="{loc:T layouteditor.redo}" Command="{Binding RedoCommand}"
                  IsEnabled="{Binding CanRedo}" />
        </StackPanel>
        <StackPanel>
          <TextBlock Text="{loc:T layouteditor.title}" Style="{StaticResource Settings.PageTitle}" AutomationProperties.HeadingLevel="Level1" />
          <TextBlock Text="{Binding ProfileText}" Style="{StaticResource Settings.Hint}" />
        </StackPanel>
      </DockPanel>

      <!-- layout.json changed outside Atap while editing. -->
      <Border Grid.Row="1" Style="{StaticResource Settings.Card}" Margin="0,8,0,0"
              Visibility="{Binding ChangedOutside, Converter={StaticResource Settings.BoolToVisibility}}">
        <DockPanel>
          <Button DockPanel.Dock="Right" Style="{StaticResource Settings.AccentButton}" Content="{loc:T layouteditor.reload}"
                  Command="{Binding ReloadCommand}" />
          <TextBlock Text="{loc:T layouteditor.changedOutside}" Style="{StaticResource Settings.Label}" TextWrapping="Wrap"
                     VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
        </DockPanel>
      </Border>

      <!-- Which notch to arrange, in plain words, and what it is. -->
      <StackPanel Grid.Row="2" Margin="0,12,0,8">
        <ListBox Style="{StaticResource Settings.Segmented}" ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}"
                 HorizontalAlignment="Left" AutomationProperties.Name="{loc:T layouteditor.tabs}" />
        <TextBlock Text="{Binding TabHint}" Style="{StaticResource Settings.Hint}" Margin="0,6,0,0" TextWrapping="Wrap" />
      </StackPanel>

      <Grid Grid.Row="3">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="20" />
          <ColumnDefinition Width="340" />
        </Grid.ColumnDefinitions>

        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <!-- Panel pages. Drop a widget on a page to move it there. -->
          <DockPanel Margin="0,0,0,10" Visibility="{Binding IsPanel, Converter={StaticResource Settings.BoolToVisibility}}">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <Button Style="{StaticResource Settings.Button}" Content="{loc:T layouteditor.addPage}" Command="{Binding AddPageCommand}"
                      IsEnabled="{Binding CanAddPage}" Margin="0,0,6,0" />
              <Button Style="{StaticResource Settings.Button}" Content="{loc:T layouteditor.removePage}" Command="{Binding RemovePageCommand}"
                      IsEnabled="{Binding CanRemovePage}" />
            </StackPanel>
            <ListBox x:Name="PageTabs" Style="{StaticResource Settings.Segmented}" ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage}"
                     HorizontalAlignment="Left" AutomationProperties.Name="{loc:T layouteditor.pages}" />
          </DockPanel>

          <!-- The notch as it will look. Widgets are dropped here. -->
          <Border x:Name="Stage" Grid.Row="1" Style="{StaticResource Settings.Card}" Padding="16" Margin="0"
                  AutomationProperties.Name="{loc:T layouteditor.preview}">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Viewbox Stretch="Uniform" StretchDirection="DownOnly" VerticalAlignment="Top" HorizontalAlignment="Center">
                <Border Background="{DynamicResource NotchSurfaceBrush}" CornerRadius="0,0,26,26" Padding="10,10,10,14"
                        MinWidth="300" MinHeight="72">
                  <Grid>
                    <ItemsControl x:Name="PreviewTiles" DataContext="{Binding Picture}" ItemsSource="{Binding Tiles}"
                                  Style="{StaticResource Preview.Tiles}" ItemTemplate="{StaticResource Editor.PreviewTile}"
                                  HorizontalAlignment="Center" KeyboardNavigation.TabNavigation="Continue"
                                  AutomationProperties.Name="{Binding AutomationName}" />
                    <TextBlock Text="{Binding Picture.EmptyText}" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                               Visibility="{Binding Picture.IsEmpty, Converter={StaticResource Settings.BoolToVisibility}}" />
                  </Grid>
                </Border>
              </Viewbox>
              <TextBlock Grid.Row="1" Text="{Binding DragHint}" Style="{StaticResource Settings.Label}" HorizontalAlignment="Center"
                         Margin="0,10,0,0" AutomationProperties.LiveSetting="Polite"
                         Visibility="{Binding IsDragging, Converter={StaticResource Settings.BoolToVisibility}}" />
            </Grid>
          </Border>

          <!-- Shown while a widget on the notch is dragged. Anywhere off the notch removes it too. -->
          <Border Grid.Row="2" Margin="0,8,0,0" Padding="12" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource InkMutedBrush}"
                  Background="{DynamicResource SettingsCardBrush}"
                  Visibility="{Binding IsDraggingPlaced, Converter={StaticResource Settings.BoolToVisibility}}">
            <TextBlock Text="{loc:T layouteditor.removeZone}" Style="{StaticResource Settings.Label}" HorizontalAlignment="Center" />
          </Border>

          <!-- The selected widget: its size, its place and Remove. The keyboard path to everything a drag does. -->
          <StackPanel Grid.Row="3" Margin="0,8,0,0">
            <Border Style="{StaticResource Settings.Card}" Visibility="{Binding HasSelection, Converter={StaticResource Settings.BoolToVisibility}}">
              <WrapPanel DataContext="{Binding Selected}" AutomationProperties.Name="{Binding Name}">
                <StackPanel VerticalAlignment="Center" Margin="0,4,20,4" MinWidth="140">
                  <TextBlock Text="{Binding Name}" Style="{StaticResource Settings.Label}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Detail}" Style="{StaticResource Settings.Hint}"
                             Visibility="{Binding HasDetail, Converter={StaticResource Settings.BoolToVisibility}}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,20,4"
                            Visibility="{Binding HasSizes, Converter={StaticResource Settings.BoolToVisibility}}">
                  <TextBlock Text="{loc:T layouteditor.size}" Style="{StaticResource Settings.Hint}" VerticalAlignment="Center" Margin="0,0,8,0" />
                  <ItemsControl ItemsSource="{Binding Sizes}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Button x:Name="Chip" Style="{StaticResource Settings.Button}" Content="{Binding Name}" Command="{Binding Pick}"
                                MinWidth="64" Padding="10,4" Margin="0,0,4,0" AutomationProperties.Name="{Binding Name}" />
                        <DataTemplate.Triggers>
                          <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter TargetName="Chip" Property="Style" Value="{StaticResource Settings.AccentButton}" />
                          </DataTrigger>
                        </DataTemplate.Triggers>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4">
                  <Button Style="{StaticResource Settings.Button}" Content="{loc:T layouteditor.earlier}" AutomationProperties.HelpText="{Binding Name}"
                          Command="{Binding MoveEarlier}" IsEnabled="{Binding CanMoveEarlier}" Margin="0,0,4,0" />
                  <Button Style="{StaticResource Settings.Button}" Content="{loc:T layouteditor.later}" AutomationProperties.HelpText="{Binding Name}"
                          Command="{Binding MoveLater}" IsEnabled="{Binding CanMoveLater}" Margin="0,0,4,0" />
                  <Button Style="{StaticResource Settings.Button}" Content="{loc:T layouteditor.remove}" AutomationProperties.HelpText="{Binding Name}"
                          Command="{Binding Remove}" />
                </StackPanel>
              </WrapPanel>
            </Border>
            <TextBlock Text="{loc:T layouteditor.selectHint}" Style="{StaticResource Settings.Hint}" TextWrapping="Wrap"
                       Visibility="{Binding ShowsSelectHint, Converter={StaticResource Settings.BoolToVisibility}}" />

            <!-- When something is live: who gets the small notch first. -->
            <ItemsControl ItemsSource="{Binding Priority}" Focusable="False"
                          Visibility="{Binding IsPriority, Converter={StaticResource Settings.BoolToVisibility}}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource Settings.Card}" Margin="0,0,0,8" Padding="14,10" AutomationProperties.Name="{Binding Name}">
                    <DockPanel>
                      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource Settings.Button}" Content="{loc:T layouteditor.up}" AutomationProperties.HelpText="{Binding Name}"
                                Command="{Binding MoveUp}" IsEnabled="{Binding CanMoveUp}" Margin="0,0,4,0" />
                        <Button Style="{StaticResource Settings.Button}" Content="{loc:T layouteditor.down}" AutomationProperties.HelpText="{Binding Name}"
                                Command="{Binding MoveDown}" IsEnabled="{Binding CanMoveDown}" />
                      </StackPanel>
                      <TextBlock Text="{Binding Rank}" Style="{StaticResource Settings.Hint}" Width="24" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding Name}" Style="{StaticResource Settings.Label}" VerticalAlignment="Center" />
                    </DockPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Grid>

        <!-- Add widgets: search, then each group with a preview of every widget. -->
        <Border Grid.Column="2" Style="{StaticResource Settings.Card}" Padding="14" Margin="0"
                Visibility="{Binding IsArranging, Converter={StaticResource Settings.BoolToVisibility}}">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top">
              <TextBlock Text="{loc:T layouteditor.addWidgets}" Style="{StaticResource Settings.SectionTitle}" Margin="0,0,0,2" />
              <TextBlock Text="{loc:T layouteditor.addHint}" Style="{StaticResource Settings.Hint}" TextWrapping="Wrap" Margin="0,0,0,8" />
              <Grid Margin="0,0,0,10">
                <TextBox Style="{StaticResource Settings.TextBox}" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="{loc:T layouteditor.search}" />
                <TextBlock Text="{loc:T layouteditor.search}" Style="{StaticResource Settings.Hint}" IsHitTestVisible="False"
                           Margin="12,0,0,0" VerticalAlignment="Center"
                           Visibility="{Binding HasNoSearch, Converter={StaticResource Settings.BoolToVisibility}}" />
              </Grid>
            </StackPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
              <ItemsControl ItemsSource="{Binding Gallery}" Focusable="False">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel>
                      <TextBlock Text="{Binding Name}" Style="{StaticResource Settings.Hint}" FontWeight="SemiBold" Margin="0,4,0,6"
                                 AutomationProperties.HeadingLevel="Level2" />
                      <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource Editor.GalleryItem}" Focusable="False" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>
        </Border>
      </Grid>

      <!-- What happens to the changes, and the ways out. -->
      <DockPanel Grid.Row="4" Margin="0,14,0,0">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Style="{StaticResource Settings.Button}" Content="{loc:T layouteditor.reset}" Command="{Binding ResetCommand}" Margin="0,0,6,0" />
          <Button Style="{StaticResource Settings.Button}" Content="{loc:T layouteditor.cancel}" Command="{Binding CancelCommand}" Margin="0,0,6,0" />
          <Button Style="{StaticResource Settings.AccentButton}" Content="{loc:T layouteditor.done}" Command="{Binding DoneCommand}" />
        </StackPanel>
        <TextBlock Text="{Binding StatusText}" Style="{StaticResource Settings.Hint}" VerticalAlignment="Center"
                   AutomationProperties.LiveSetting="Polite" />
      </DockPanel>
    </Grid>

    <!-- The dragged widget follows the pointer. A still picture, so nothing re-renders under it. -->
    <Canvas IsHitTestVisible="False">
      <Image x:Name="Ghost" Visibility="Collapsed" Opacity="0.85" />
    </Canvas>
  </Grid>
</Window>
