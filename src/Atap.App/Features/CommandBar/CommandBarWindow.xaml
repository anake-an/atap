<Window x:Class="Atap.Features.CommandBar.CommandBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Atap.Ui.Localization"
        Title="{loc:T commandbar.open}"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        SizeToContent="Height"
        Width="640"
        WindowStartupLocation="Manual"
        Left="-32000"
        Top="-32000"
        UseLayoutRounding="True"
        FontFamily="{StaticResource TextFont}">

  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Atap;component/Ui/Theme/Settings.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <!-- One result: its icon, the text, and what Enter does. The chosen row has the accent bar, as in dropdowns. -->
      <Style x:Key="CommandBar.Row" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
        <Setter Property="AutomationProperties.HelpText" Value="{Binding Detail}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ListBoxItem">
              <Grid>
                <Border x:Name="Chrome" Background="Transparent" CornerRadius="6" Padding="12,9">
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="{Binding Glyph}" FontFamily="{DynamicResource IconFont}" FontSize="16"
                               Foreground="{DynamicResource InkSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,14,0" />
                    <TextBlock x:Name="Detail" DockPanel.Dock="Right" Text="{Binding Detail}" FontSize="12"
                               Foreground="{DynamicResource InkMutedBrush}" VerticalAlignment="Center" Margin="12,0,0,0" Visibility="Hidden" />
                    <TextBlock Text="{Binding Title}" FontSize="15" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                  </DockPanel>
                </Border>
                <Border x:Name="Marker" Width="3" Height="18" CornerRadius="1.5" HorizontalAlignment="Left" VerticalAlignment="Center"
                        Background="{DynamicResource ToggleOnBrush}" Visibility="Collapsed" />
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource WindowBrush}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                  <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SettingsNavSelectedBrush}" />
                  <Setter TargetName="Marker" Property="Visibility" Value="Visible" />
                  <Setter TargetName="Detail" Property="Visibility" Value="Visible" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </Window.Resources>

  <!-- The margin is room for the shadow. -->
  <Border Margin="16"
          Padding="8"
          CornerRadius="10"
          Background="{DynamicResource SettingsCardBrush}"
          BorderBrush="{DynamicResource SettingsCardBorderBrush}"
          BorderThickness="1">
    <Border.Effect>
      <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" Opacity="0.22" />
    </Border.Effect>

    <StackPanel>
      <Grid>
        <TextBlock Text="&#xE721;" FontFamily="{DynamicResource IconFont}" FontSize="16" Foreground="{DynamicResource InkSecondaryBrush}"
                   VerticalAlignment="Center" Margin="14,0,0,0" IsHitTestVisible="False" />
        <TextBox x:Name="Box"
                 Style="{StaticResource Settings.TextBox}"
                 Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                 FontSize="18"
                 MinHeight="48"
                 Padding="36,8,12,8"
                 Background="Transparent"
                 BorderBrush="Transparent"
                 AutomationProperties.Name="{Binding Placeholder}" />
        <TextBlock Text="{Binding Placeholder}" FontSize="18" Foreground="{DynamicResource InkMutedBrush}"
                   VerticalAlignment="Center" Margin="39,0,0,0" IsHitTestVisible="False">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding Query}" Value="">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </Grid>

      <ListBox x:Name="Results"
               ItemsSource="{Binding Rows}"
               SelectedIndex="{Binding SelectedIndex}"
               ItemContainerStyle="{StaticResource CommandBar.Row}"
               Background="Transparent"
               BorderThickness="0"
               Focusable="False"
               Margin="0,6,0,0"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               AutomationProperties.Name="{loc:T commandbar.results}"
               Visibility="{Binding HasRows, Converter={StaticResource Settings.BoolToVisibility}}" />
    </StackPanel>
  </Border>
</Window>
