<Window x:Class="Atap.Notch.NotchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Atap.Ui.Localization"
        xmlns:controls="clr-namespace:Atap.Ui.Controls"
        xmlns:notch="clr-namespace:Atap.Notch"
        Title="Atap"
        Icon="/Atap;component/Assets/atap.ico"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        SizeToContent="Manual"
        Width="120"
        Height="32"
        UseLayoutRounding="True"
        FontFamily="{StaticResource TextFont}">

  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />

    <!-- Submenu entries built from MenuOptionViewModel. -->
    <Style x:Key="MenuOptionStyle" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
      <Setter Property="Header" Value="{Binding Header}" />
      <Setter Property="IsChecked" Value="{Binding IsChecked, Mode=OneWay}" />
      <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
      <Setter Property="Command" Value="{Binding Command}" />
    </Style>
  </Window.Resources>

  <!-- The window is transparent and only as big as the notch and its shoulders (plus room for the resize spring).
       Padding, shoulder room and alignment follow the anchor; see NotchWindow.ApplyAnchorStyle. -->
  <Grid>
    <Grid x:Name="Notch"
          HorizontalAlignment="Center"
          VerticalAlignment="Top"
          MouseEnter="Notch_MouseEnter"
          MouseLeave="Notch_MouseLeave"
          MouseWheel="Notch_MouseWheel"
          MouseDown="Notch_MouseDown"
          MouseLeftButtonUp="Notch_MouseLeftButtonUp"
          AllowDrop="True"
          PreviewDragEnter="Notch_PreviewDragEnter"
          PreviewDragLeave="Notch_PreviewDragLeave"
          PreviewDrop="Notch_PreviewDrop"
          DragEnter="Notch_DragOver"
          DragOver="Notch_DragOver">
      <Grid.ContextMenu>
        <!-- DataContext is the shared NotchMenuViewModel, set in code. Commands with a menu group are
             inserted above CommandsEnd each time the menu opens. -->
        <ContextMenu x:Name="NotchMenu" Opened="NotchMenu_Opened" Closed="NotchMenu_Closed">
          <MenuItem Header="{Binding VersionHeader}" IsEnabled="False" />
          <Separator />
          <MenuItem Header="{loc:T notch.menu.position}"
                    ItemsSource="{Binding PositionOptions}"
                    ItemContainerStyle="{StaticResource MenuOptionStyle}" />
          <MenuItem Header="{loc:T notch.menu.monitor}"
                    ItemsSource="{Binding MonitorOptions}"
                    ItemContainerStyle="{StaticResource MenuOptionStyle}" />
          <MenuItem Header="{loc:T notch.menu.editLayoutSoon}"
                    IsEnabled="False"
                    Visibility="{Binding ShowEditLayoutPlaceholder, Converter={StaticResource BooleanToVisibility}}" />
          <Separator x:Name="CommandsEnd" />
          <MenuItem Header="{Binding UpdateHeader}"
                    Command="{Binding CheckForUpdatesCommand}"
                    Visibility="{Binding ShowUpdateItem, Converter={StaticResource BooleanToVisibility}}" />
          <MenuItem Header="{loc:T notch.menu.quit}" Command="{Binding QuitCommand}" />
        </ContextMenu>
      </Grid.ContextMenu>

      <!-- The notch and its shoulders as one filled outline, so there is no seam and the shoulders take the mouse too.
           The canvas has no size of its own, so the outline never feeds back into layout. See NotchWindow.UpdateOutline. -->
      <Canvas>
        <Path x:Name="NotchFill" Fill="{DynamicResource NotchBackgroundBrush}">
          <Path.Style>
            <!-- In high contrast the notch takes the window colour, so a thin outline shows where it ends. -->
            <Style TargetType="Path">
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsHigh, Source={x:Static controls:Contrast.Current}}" Value="True">
                  <Setter Property="Stroke" Value="{DynamicResource TextBrush}" />
                  <Setter Property="StrokeThickness" Value="1" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Path.Style>
        </Path>
      </Canvas>

      <!-- The content area. Its margin is the shoulder room at both ends along the screen edge.
           The surface template ("surface.<Name>" from Notch/Surfaces) is picked in code when the surface changes.
           The frame keeps the content at its own size while the pill springs, so it is laid out once per change. -->
      <Border x:Name="Pill"
              Padding="14,6,14,8"
              ClipToBounds="True">
        <notch:NotchContentFrame x:Name="ContentFrame">
          <ContentPresenter x:Name="SurfaceHost"
                            Content="{Binding}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
        </notch:NotchContentFrame>
      </Border>
    </Grid>
  </Grid>
</Window>
