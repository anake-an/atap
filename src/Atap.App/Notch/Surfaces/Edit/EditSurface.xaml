<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Atap.Ui.Controls"
                    xmlns:loc="clr-namespace:Atap.Ui.Localization">

  <!-- While the layout editor is open the notch shows only this badge, so it never covers the editor and
       nothing changes under the person editing. The editor window shows the layout itself. -->
  <DataTemplate x:Key="surface.Edit">
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12,6"
                AutomationProperties.Name="{loc:T layouteditor.notchBadge}">
      <controls:StrokeIcon Data="{DynamicResource icon.edit}" Foreground="{DynamicResource AccentBrush}"
                           Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
      <TextBlock Text="{loc:T layouteditor.notchBadge}" Foreground="{DynamicResource TextBrush}"
                 FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
    </StackPanel>
  </DataTemplate>

</ResourceDictionary>
