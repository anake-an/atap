<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:alerts="clr-namespace:Atap.Core.Alerts;assembly=Atap.Core"
                    xmlns:surface="clr-namespace:Atap.Notch.Surfaces.Alerts"
                    xmlns:loc="clr-namespace:Atap.Ui.Localization"
                    xmlns:automation="clr-namespace:Atap.Notch.Automation">

  <!-- The alert pill. The alerts feature gives this surface an AlertViewModel (NotchViewModel.SurfaceContent).
       It takes the compact shape and shoulders the notch already draws, then the compact owner returns.
       The notch resizes only when the surface changes, not when one alert follows another, so the pill
       keeps one size per edge. Nothing in it animates. -->

  <BooleanToVisibilityConverter x:Key="alert.visible" />

  <!-- The glyph follows the tone. -->
  <Style x:Key="alert.glyph" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource IconFont}" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding Tone}" Value="{x:Static alerts:AlertTone.Positive}">
        <Setter Property="Foreground" Value="{DynamicResource MediaAccentBrush}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Tone}" Value="{x:Static alerts:AlertTone.Warning}">
        <Setter Property="Foreground" Value="{DynamicResource ProductivityAccentBrush}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Tone}" Value="{x:Static alerts:AlertTone.Negative}">
        <Setter Property="Foreground" Value="{DynamicResource SystemAccentBrush}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- The filled part of the level bar, in the tone's colour. -->
  <Style x:Key="alert.levelFill" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource TextBrush}" />
    <Setter Property="CornerRadius" Value="2" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding Tone}" Value="{x:Static alerts:AlertTone.Positive}">
        <Setter Property="Background" Value="{DynamicResource MediaAccentBrush}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Tone}" Value="{x:Static alerts:AlertTone.Warning}">
        <Setter Property="Background" Value="{DynamicResource ProductivityAccentBrush}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Tone}" Value="{x:Static alerts:AlertTone.Negative}">
        <Setter Property="Background" Value="{DynamicResource SystemAccentBrush}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="alert.title" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <Style x:Key="alert.detail" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <!-- A small button with a plain word on it. Like the rest of the notch, it takes focus only while the panel has the keyboard. -->
  <Style x:Key="alert.button" TargetType="Button">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="FocusVisualStyle" Value="{DynamicResource NotchFocusVisual}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="10,3" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Chrome"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="1"
                  CornerRadius="6"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource TextMutedBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource CardBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="automation:KeyboardMode.IsOn" Value="True">
        <Setter Property="Focusable" Value="True" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- The level bar with its percentage, for volume, brightness and progress. -->
  <DataTemplate x:Key="alert.level">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Grid Height="4" VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="{Binding LevelFilled}" />
          <ColumnDefinition Width="{Binding LevelEmpty}" />
        </Grid.ColumnDefinitions>
        <Border Grid.ColumnSpan="2" Background="{DynamicResource RaisedBrush}" CornerRadius="2" />
        <Border Style="{StaticResource alert.levelFill}" />
      </Grid>
      <TextBlock Grid.Column="1"
                 Text="{Binding LevelText}"
                 Style="{StaticResource alert.detail}"
                 MinWidth="32"
                 Margin="8,0,0,0"
                 TextAlignment="Right" />
    </Grid>
  </DataTemplate>

  <!-- Stop while a sound plays, Close for a Critical alert. Only one shows at a time. -->
  <DataTemplate x:Key="alert.buttons">
    <Grid>
      <Button Style="{StaticResource alert.button}"
              Content="{loc:T alerts.stop}"
              ToolTip="{loc:T alerts.stopHint}"
              AutomationProperties.Name="{loc:T alerts.stopHint}"
              Command="{Binding StopCommand}"
              Visibility="{Binding CanStop, Converter={StaticResource alert.visible}}" />
      <Button Style="{StaticResource alert.button}"
              Content="{loc:T alerts.close}"
              ToolTip="{loc:T alerts.closeHint}"
              AutomationProperties.Name="{loc:T alerts.closeHint}"
              Command="{Binding CloseCommand}"
              Visibility="{Binding ShowClose, Converter={StaticResource alert.visible}}" />
    </Grid>
  </DataTemplate>

  <!-- Along the top edge: glyph, two lines of text and the button in a row. -->
  <DataTemplate x:Key="alert.wide">
    <Grid Width="260"
          Height="36"
          Background="Transparent"
          surface:AlertLiveRegion.Announce="True"
          AutomationProperties.Name="{Binding AccessibleSummary}"
          AutomationProperties.LiveSetting="{Binding LiveSetting}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <TextBlock Text="{Binding Glyph}" Style="{StaticResource alert.glyph}" Margin="2,0,10,0" />

      <StackPanel Grid.Column="1" VerticalAlignment="Center">
        <TextBlock Text="{Binding Title}" Style="{StaticResource alert.title}" />
        <TextBlock Text="{Binding Subtitle}"
                   Style="{StaticResource alert.detail}"
                   Visibility="{Binding HasSubtitle, Converter={StaticResource alert.visible}}" />
        <ContentPresenter Content="{Binding}"
                          ContentTemplate="{StaticResource alert.level}"
                          Margin="0,4,0,0"
                          Visibility="{Binding HasLevel, Converter={StaticResource alert.visible}}" />
      </StackPanel>

      <ContentPresenter Grid.Column="2"
                        Content="{Binding}"
                        ContentTemplate="{StaticResource alert.buttons}"
                        Margin="10,0,0,0"
                        VerticalAlignment="Center" />
    </Grid>
  </DataTemplate>

  <!-- On a side edge the notch is narrow, so the text wraps and the button sits below it. -->
  <DataTemplate x:Key="alert.tall">
    <DockPanel Width="132"
               Height="132"
               Background="Transparent"
               surface:AlertLiveRegion.Announce="True"
               AutomationProperties.Name="{Binding AccessibleSummary}"
               AutomationProperties.LiveSetting="{Binding LiveSetting}">
      <TextBlock DockPanel.Dock="Top"
                 Text="{Binding Glyph}"
                 Style="{StaticResource alert.glyph}"
                 HorizontalAlignment="Center"
                 Margin="0,2,0,6" />
      <ContentPresenter DockPanel.Dock="Bottom"
                        Content="{Binding}"
                        ContentTemplate="{StaticResource alert.buttons}"
                        HorizontalAlignment="Center"
                        Margin="0,6,0,0" />
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="{Binding Title}"
                   Style="{StaticResource alert.title}"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   MaxHeight="36" />
        <TextBlock Text="{Binding Subtitle}"
                   Style="{StaticResource alert.detail}"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   MaxHeight="30"
                   Margin="0,2,0,0"
                   Visibility="{Binding HasSubtitle, Converter={StaticResource alert.visible}}" />
        <ContentPresenter Content="{Binding}"
                          ContentTemplate="{StaticResource alert.level}"
                          Margin="0,6,0,0"
                          Visibility="{Binding HasLevel, Converter={StaticResource alert.visible}}" />
      </StackPanel>
    </DockPanel>
  </DataTemplate>

  <!-- The surface gets the window's NotchViewModel. The alert itself is its SurfaceContent. -->
  <DataTemplate x:Key="surface.Alert">
    <ContentControl Content="{Binding SurfaceContent}" Focusable="False" IsTabStop="False">
      <ContentControl.Style>
        <Style TargetType="ContentControl">
          <Setter Property="ContentTemplate" Value="{StaticResource alert.wide}" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding IsVertical}" Value="True">
              <Setter Property="ContentTemplate" Value="{StaticResource alert.tall}" />
            </DataTrigger>
            <!-- A template would still build with no alert, as an empty pill. -->
            <DataTrigger Binding="{Binding SurfaceContent}" Value="{x:Null}">
              <Setter Property="ContentTemplate" Value="{x:Null}" />
              <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </ContentControl.Style>
    </ContentControl>
  </DataTemplate>

</ResourceDictionary>
